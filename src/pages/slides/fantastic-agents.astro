  </style>

  <script is:inline>
  (() => {
    const params = new URLSearchParams(location.search);
    const still = params.get('still') === '1';
    if (still) document.documentElement.dataset.still = '1';
    const reduced = still || matchMedia('(prefers-reduced-motion: reduce)').matches;
    const deck = document.getElementById('deck');
    const slides = [...document.querySelectorAll('.slide')];
    const progress = document.getElementById('progress');

    /* ---------- ambience: inject the atmospheric layers ---------- */
    slides.forEach(slide => {
      const aether = document.createElement('div');
      aether.className = 'aether';
      aether.setAttribute('aria-hidden', 'true');
      aether.innerHTML = '<div class="glowfield"></div><div class="ley"></div><div class="mist m1"></div><div class="mist m2"></div><canvas></canvas><div class="vignette"></div>';
      slide.prepend(aether);

      const grain = document.createElement('div');
      grain.className = 'grain'; grain.setAttribute('aria-hidden', 'true');
      slide.appendChild(grain);

      const frame = document.createElement('div');
      frame.className = 'frame'; frame.setAttribute('aria-hidden', 'true');
      frame.innerHTML = '<i class="tl"></i><i class="tr"></i><i class="bl"></i><i class="br"></i>';
      slide.appendChild(frame);
    });

    /* ---------- ink: stagger every drawn stroke ---------- */
    document.querySelectorAll('.beast--draw').forEach(beast => {
      const strokes = beast.querySelectorAll('.ink-line path, .ink-web path');
      strokes.forEach((p, i) => { p.style.animationDelay = (0.06 + i * 0.035).toFixed(3) + 's'; });
    });

    /* ---------- charts: a light travels the meaningful wires ---------- */
    document.querySelectorAll('.chart svg').forEach(svg => {
      const lit = [...svg.querySelectorAll('.wire.lit')];
      lit.forEach((w, i) => {
        w.style.animationDelay = (i * 0.08).toFixed(2) + 's';
        if (reduced) return;
        const pulse = w.cloneNode(false);
        pulse.setAttribute('class', 'pulse');
        pulse.style.animationDelay = (1.2 + i * 0.26).toFixed(2) + 's';
        svg.appendChild(pulse);
      });
      svg.querySelectorAll('.wire:not(.lit)').forEach((w, i) => {
        w.style.animationDelay = (0.15 + i * 0.06).toFixed(2) + 's';
      });
    });

    /* ---------- cover: ignite the title letter by letter ---------- */
    const title = document.getElementById('coverTitle');
    if (title && !reduced) {
      let n = 0;
      title.querySelectorAll('.ln').forEach((line, li) => {
        const text = line.textContent;
        line.textContent = '';
        [...text].forEach(ch => {
          const s = document.createElement('span');
          s.className = 'cl'; s.textContent = ch;
          s.style.animationDelay = (0.55 + li * 0.22 + n * 0.036).toFixed(3) + 's';
          line.appendChild(s); n++;
        });
      });
    }

    /* ---------- dust motes: candlelight in the air ---------- */
    class Motes {
      constructor(slide) {
        this.slide = slide;
        this.canvas = slide.querySelector('.aether canvas');
        this.ctx = this.canvas.getContext('2d');
        this.parchment = slide.classList.contains('parchment');
        this.cover = slide.classList.contains('cover');
        this.dots = [];
        this.live = false;
        this.resize();
      }
      resize() {
        const r = this.slide.getBoundingClientRect();
        const dpr = Math.min(devicePixelRatio || 1, 2);
        this.w = Math.max(r.width, 1); this.h = Math.max(r.height, 1);
        this.canvas.width = this.w * dpr; this.canvas.height = this.h * dpr;
        this.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        this.seed();
      }
      seed() {
        const count = Math.round((this.w * this.h) / (this.parchment ? 42000 : 20000));
        this.dots = Array.from({ length: count }, () => this.spawn(true));
      }
      spawn(anywhere) {
        return {
          x: Math.random() * this.w,
          y: anywhere ? Math.random() * this.h : this.h + Math.random() * 60,
          r: Math.random() * 1.7 + .5,
          vy: -(Math.random() * .22 + .05),
          drift: (Math.random() - .5) * .22,
          phase: Math.random() * Math.PI * 2,
          speed: Math.random() * .02 + .006,
          a: Math.random() * .5 + .25
        };
      }
      burst() {
        if (!this.cover) return;
        const cx = this.w / 2, cy = this.h * .44;
        for (let i = 0; i < 90; i++) {
          const ang = Math.random() * Math.PI * 2, sp = Math.random() * 5 + 1.4;
          this.dots.push({
            x: cx, y: cy, r: Math.random() * 2 + .7,
            vx: Math.cos(ang) * sp, vy: Math.sin(ang) * sp * .6,
            decay: .972, ember: true, a: 1, phase: 0, speed: .03, drift: 0
          });
        }
      }
      frame(t) {
        const c = this.ctx;
        c.clearRect(0, 0, this.w, this.h);
        for (let i = this.dots.length - 1; i >= 0; i--) {
          const d = this.dots[i];
          if (d.ember) {
            d.x += d.vx; d.y += d.vy; d.vx *= d.decay; d.vy = d.vy * d.decay + .02; d.a *= .987;
            if (d.a < .02) { this.dots.splice(i, 1); continue; }
          } else {
            d.y += d.vy; d.x += Math.sin(t * .0004 + d.phase) * .28 + d.drift * .3;
            if (d.y < -20) Object.assign(d, this.spawn(false));
          }
          const tw = d.ember ? d.a : d.a * (.55 + .45 * Math.sin(t * d.speed * .06 + d.phase));
          c.beginPath();
          c.arc(d.x, d.y, d.r, 0, 6.283);
          c.fillStyle = this.parchment
            ? `rgba(140,110,50,${tw * .32})`
            : `rgba(${d.ember ? '255,236,196' : '242,209,150'},${tw})`;
          if (!this.parchment) { c.shadowBlur = d.r * 4; c.shadowColor = 'rgba(242,201,126,.75)'; }
          c.fill(); c.shadowBlur = 0;
        }
      }
    }

    const engines = new Map();
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      slides.forEach(s => engines.set(s, new Motes(s)));
      let ticking = null;
      addEventListener('resize', () => {
        clearTimeout(ticking);
        ticking = setTimeout(() => engines.forEach(e => e.resize()), 180);
      });
      if (!still) {
        const loop = t => { engines.forEach(e => { if (e.live) e.frame(t); }); requestAnimationFrame(loop); };
        requestAnimationFrame(loop);
      }
    }

    /* ---------- navigation ---------- */
    let current = 0, locked = false, startY = 0;
    const setLive = () => {
      slides.forEach((s, i) => {
        const e = engines.get(s);
        if (e) e.live = Math.abs(i - current) <= 1;
      });
    };
    const update = () => {
      progress.style.width = ((current + 1) / slides.length) * 100 + '%';
      setLive();
    };
    const turn = document.getElementById('turn');
    let turnTimer = null;
    const sweep = () => {
      if (reduced) return;
      turn.classList.remove('on');
      void turn.offsetWidth;
      turn.classList.add('on');
      clearTimeout(turnTimer);
      turnTimer = setTimeout(() => turn.classList.remove('on'), 700);
    };
    const go = (i, instant) => {
      if (i < 0 || i >= slides.length || i === current) return;
      if (!instant) sweep();
      current = i;
      slides[i].classList.add('visible');
      slides[i].scrollIntoView({ behavior: (reduced || instant) ? 'instant' : 'smooth', block: 'start' });
      update();
    };

    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting && entry.intersectionRatio > .55) {
          current = slides.indexOf(entry.target);
          entry.target.classList.add('visible');
          const e = engines.get(entry.target);
          if (e && entry.target.classList.contains('cover')) e.burst();
          update();
        }
      });
    }, { root: deck, threshold: [.55] });
    slides.forEach(s => observer.observe(s));
    slides[0].classList.add('visible');
    update();
    const e0 = engines.get(slides[0]); if (e0) setTimeout(() => e0.burst(), 260);

    const requested = Number.parseInt(params.get('slide'), 10);
    if (Number.isInteger(requested)) {
      requestAnimationFrame(() => go(Math.max(0, Math.min(slides.length - 1, requested - 1)), true));
    }
    if (still) {
      slides.forEach(s => s.classList.add('visible'));
      requestAnimationFrame(() => engines.forEach(e => { e.live = true; e.frame(0); }));
    }

    addEventListener('keydown', e => {
      if (['ArrowDown', 'ArrowRight', 'PageDown', ' '].includes(e.key)) { e.preventDefault(); go(current + 1); }
      if (['ArrowUp', 'ArrowLeft', 'PageUp'].includes(e.key)) { e.preventDefault(); go(current - 1); }
      if (e.key === 'Home') { e.preventDefault(); go(0); }
      if (e.key === 'End') { e.preventDefault(); go(slides.length - 1); }
    });
    deck.addEventListener('wheel', e => {
      if (locked || Math.abs(e.deltaY) < 12) return;
      e.preventDefault(); locked = true;
      go(current + (e.deltaY > 0 ? 1 : -1));
      setTimeout(() => locked = false, reduced ? 0 : 700);
    }, { passive: false });
    deck.addEventListener('touchstart', e => { startY = e.touches[0].clientY; }, { passive: true });
    deck.addEventListener('touchend', e => {
      const d = startY - e.changedTouches[0].clientY;
      if (Math.abs(d) > 45) go(current + (d > 0 ? 1 : -1));
    }, { passive: true });
  })();

  </script>
</Base>

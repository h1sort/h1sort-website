          <pre class="code"><span class="k">agent</span> = create_agent(
  model=model,
  tools=[search_policies,
         get_policy, check_version],
  middleware=[
    ModelCallLimitMiddleware(run_limit=<span class="n">6</span>),
<span class="lit">    ToolCallLimitMiddleware(run_limit=<span class="n">5</span>,
      exit_behavior="error"),</span>
  ],
  context_schema=EmployeeContext,
  response_format=GroundedAnswer,
)</pre>
        </div>
        <div class="reveal">
          <h2>Bounded. Attributable. Traceable.</h2>
          <div class="notes">
            <p class="note">A tool description is not authorization.</p>
            <p class="note">Trusted identity travels in runtime context.</p>
            <p class="note">Schema validates shape; code verifies citations.</p>
          </div>
          <pre class="code" style="margin-top:1.2rem"><span class="c"># inside the tool</span>
return index.search(

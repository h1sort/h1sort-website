---
import Base from '../layouts/Base.astro';
---

<Base
  title="Live Polls · h1sort"
  description="Create and participate in live polls from h1sort.com."
  path="/polls"
  assistant={false}
>
  <main class="polls-page">
    <header class="rule-top">
      <a class="brand link" href="/">
        <svg class="brand-mark" viewBox="0 0 64 40" aria-hidden="true">
          <rect x="2" y="26" width="10" height="12" rx="1.5"></rect>
          <rect x="18" y="16" width="10" height="22" rx="1.5"></rect>
          <rect x="34" y="8" width="10" height="30" rx="1.5"></rect>
          <rect x="50" y="2" width="10" height="36" rx="1.5"></rect>
        </svg>
        <span class="strong">h1sort.com</span>
      </a>
      <span>Live polls</span>
    </header>

    <section class="boot-state" id="bootState" aria-live="polite">
      <span class="acid-label">Polls</span>
      <p>Loading the room...</p>
    </section>

    <section class="vote-view" id="voteView" hidden>
      <div class="vote-card">
        <div class="eyebrow-row">
          <span class="acid-label" id="voteGroup">Live poll</span>
          <span class="status-chip" id="voteStatus"></span>
        </div>
        <h1 id="voteQuestion">Find the poll</h1>
        <p class="vote-intro" id="voteIntro"></p>
        <form class="vote-form" id="voteForm"></form>
        <div class="results" id="voteResults"></div>
        <p class="form-note" id="voteMessage" role="status" aria-live="polite"></p>
      </div>
      <a class="quiet-link link" href="/polls">Manage polls</a>
    </section>

    <section class="login-view" id="loginView" hidden>
      <div class="login-copy">
        <span class="acid-label">Private tool</span>
        <h1>Run the <span class="marker paint">room.</span></h1>
        <p>Create poll groups, share short links and QR codes, then open or close voting on your terms.</p>
      </div>
      <form class="panel login-form" id="loginForm">
        <div class="panel-heading">
          <span class="mono-label">Admin access</span>
          <span class="index-number">01</span>
        </div>
        <label>
          <span>Username</span>
          <input name="username" type="text" autocomplete="username" value="h1sort" maxlength="128" required />
        </label>
        <label>
          <span>Password</span>
          <input name="password" type="password" autocomplete="current-password" maxlength="1024" required />
        </label>
        <button class="action action-primary" type="submit">Sign in <span aria-hidden="true">→</span></button>
        <p class="form-note" id="loginMessage" role="status" aria-live="polite"></p>
      </form>
    </section>

    <section class="dashboard" id="dashboard" hidden>
      <div class="dashboard-heading">
        <div>
          <span class="acid-label">Control room</span>
          <h1>Ask. Share. <span class="marker paint">Count.</span></h1>
          <p>Each poll gets an independent short link and scannable QR code.</p>
        </div>
        <div class="dashboard-actions">
          <button class="action" id="refreshButton" type="button">Refresh</button>
          <button class="action" id="logoutButton" type="button">Sign out</button>
        </div>
      </div>

      <form class="panel group-form" id="groupForm">
        <div class="panel-heading">
          <span class="mono-label">New group</span>
          <span class="index-number">01</span>
        </div>
        <div class="inline-form">
          <label>
            <span>Group title</span>
            <input name="title" type="text" placeholder="Data team offsite" maxlength="120" required />
          </label>
          <button class="action action-primary" type="submit">Create group</button>
        </div>
        <p class="form-note" id="groupMessage" role="status" aria-live="polite"></p>
      </form>

      <div class="groups" id="groups"></div>
      <p class="empty-state" id="emptyState" hidden>No groups yet. Create one above to start sorting opinions.</p>
    </section>

    <noscript>
      <section class="noscript panel">JavaScript is required to manage or vote in live polls.</section>
    </noscript>

    <footer class="rule-bottom">
      <span class="strong">h1sort polls</span>
      <a class="link" href="/">← Back to landing</a>
    </footer>
  </main>

  <script>
    import QRCode from 'qrcode';

    type PollStatus = 'draft' | 'open' | 'closed';
    type PollOption = {
      id: string;
      label: string;
      position: number;
      count?: number;
    };
    type Poll = {
      id: string;
      groupId: string;
      groupTitle?: string;
      code: string;
      question: string;
      status: PollStatus;
      openedAt: string | null;
      closedAt: string | null;
      options: PollOption[];
      total?: number;
    };
    type PollGroup = {
      id: string;
      title: string;
      createdAt: string;
      polls: Poll[];
    };
    type ApiFailure = { error?: string };

    class ApiError extends Error {
      constructor(readonly status: number, message: string) {
        super(message);
        this.name = 'ApiError';
      }
    }

    const byId = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const bootState = byId<HTMLElement>('bootState');
    const voteView = byId<HTMLElement>('voteView');
    const loginView = byId<HTMLElement>('loginView');
    const dashboard = byId<HTMLElement>('dashboard');
    const loginForm = byId<HTMLFormElement>('loginForm');
    const groupForm = byId<HTMLFormElement>('groupForm');
    const groupsElement = byId<HTMLElement>('groups');
    const emptyState = byId<HTMLElement>('emptyState');
    const voteForm = byId<HTMLFormElement>('voteForm');
    let activeVoteCode = '';

    const escapeHtml = (value: string) => value.replace(/[&<>'"]/g, (character) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      "'": '&#39;',
      '"': '&quot;',
    })[character] ?? character);

    const setVisible = (element: HTMLElement, visible: boolean) => {
      element.hidden = !visible;
    };

    const setMessage = (id: string, message: string, error = false) => {
      const element = byId<HTMLElement>(id);
      element.textContent = message;
      element.classList.toggle('is-error', error);
    };

    const setBusy = (form: HTMLFormElement, busy: boolean) => {
      form.querySelectorAll<HTMLButtonElement>('button').forEach((button) => {
        button.disabled = busy;
      });
      form.setAttribute('aria-busy', String(busy));
    };

    async function requestJson<T>(path: string, init?: RequestInit): Promise<T> {
      const response = await fetch(path, {
        credentials: 'same-origin',
        ...init,
        headers: init?.body
          ? { 'content-type': 'application/json', ...init.headers }
          : init?.headers,
      });
      let data: T | ApiFailure;
      try {
        data = await response.json() as T | ApiFailure;
      } catch {
        throw new ApiError(response.status, 'Unexpected server response');
      }
      if (!response.ok) {
        const failure = data as ApiFailure;
        throw new ApiError(response.status, failure.error ?? 'Request failed');
      }
      return data as T;
    }

    const statusLabel = (status: PollStatus) => ({
      draft: 'Draft',
      open: 'Open now',
      closed: 'Closed',
    })[status];

    const resultRows = (poll: Poll) => {
      const total = poll.total ?? poll.options.reduce((sum, option) => sum + (option.count ?? 0), 0);
      return `
        <div class="result-summary">
          <span class="mono-label">Results</span>
          <strong>${total} ${total === 1 ? 'vote' : 'votes'}</strong>
        </div>
        <div class="result-list">
          ${poll.options.map((option) => {
            const count = option.count ?? 0;
            const percentage = total ? Math.round(count / total * 100) : 0;
            return `
              <div class="result-row">
                <div class="result-copy">
                  <span>${escapeHtml(option.label)}</span>
                  <strong>${count} · ${percentage}%</strong>
                </div>
                <span class="result-track"><span style="width: ${percentage}%"></span></span>
              </div>
            `;
          }).join('')}
        </div>
      `;
    };

    async function renderQrCodes() {
      const styles = getComputedStyle(document.documentElement);
      const dark = styles.getPropertyValue('--ink').trim();
      const light = styles.getPropertyValue('--bg').trim();
      await Promise.all(Array.from(document.querySelectorAll<HTMLImageElement>('[data-qr-url]')).map(async (image) => {
        const url = image.dataset.qrUrl;
        if (!url) return;
        const source = await QRCode.toDataURL(url, {
          width: 192,
          margin: 2,
          errorCorrectionLevel: 'M',
          color: { dark, light },
        });
        image.src = source;
        const download = image.closest('.share-panel')?.querySelector<HTMLAnchorElement>('[data-qr-download]');
        if (download) download.href = source;
      }));
    }

    function renderGroups(groups: PollGroup[]) {
      emptyState.hidden = groups.length > 0;
      groupsElement.innerHTML = groups.map((group, groupIndex) => `
        <section class="group panel">
          <div class="group-heading">
            <div>
              <span class="mono-label">Group ${String(groupIndex + 1).padStart(2, '0')}</span>
              <h2>${escapeHtml(group.title)}</h2>
            </div>
            <span class="group-count">${group.polls.length} ${group.polls.length === 1 ? 'poll' : 'polls'}</span>
          </div>

          <form class="poll-form" data-group-id="${group.id}">
            <div class="poll-form-grid">
              <label>
                <span>Question</span>
                <textarea name="question" placeholder="Which system should we improve first?" maxlength="500" required></textarea>
              </label>
              <label>
                <span>Options, one per line</span>
                <textarea name="labels" placeholder="Data quality&#10;Deployment speed&#10;Observability" required></textarea>
              </label>
            </div>
            <div class="form-footer">
              <span>2–8 unique options</span>
              <button class="action action-primary" type="submit">Add poll</button>
            </div>
            <p class="form-note" data-poll-message role="status" aria-live="polite"></p>
          </form>

          <div class="poll-list">
            ${group.polls.length ? group.polls.map((poll) => {
              const shortUrl = `${location.origin}/p/${poll.code}`;
              const nextStatus: PollStatus = poll.status === 'open' ? 'closed' : 'open';
              const nextLabel = poll.status === 'open' ? 'Close voting' : poll.status === 'closed' ? 'Reopen voting' : 'Open voting';
              return `
                <article class="poll-card">
                  <div class="poll-main">
                    <div class="poll-meta">
                      <span class="status-chip status-${poll.status}">${statusLabel(poll.status)}</span>
                      <span class="poll-code">${poll.code}</span>
                    </div>
                    <h3>${escapeHtml(poll.question)}</h3>
                    <div class="admin-results">${resultRows(poll)}</div>
                    <div class="poll-actions">
                      <button class="action action-primary" type="button" data-poll-id="${poll.id}" data-next-status="${nextStatus}">${nextLabel}</button>
                      <button class="action" type="button" data-copy-url="${shortUrl}">Copy link</button>
                    </div>
                  </div>
                  <aside class="share-panel">
                    <img data-qr-url="${shortUrl}" alt="QR code for ${escapeHtml(poll.question)}" width="192" height="192" />
                    <a class="short-url link" href="${shortUrl}" target="_blank" rel="noopener">h1sort.com/p/${poll.code}</a>
                    <a class="download-link" data-qr-download download="h1sort-poll-${poll.code}.png">Download QR</a>
                  </aside>
                </article>
              `;
            }).join('') : '<p class="group-empty">No polls in this group yet.</p>'}
          </div>
        </section>
      `).join('');
      void renderQrCodes();
    }

    async function loadGroups() {
      const data = await requestJson<{ groups: PollGroup[] }>('/api/polls/admin/groups');
      renderGroups(data.groups);
    }

    async function showDashboard() {
      setVisible(bootState, false);
      setVisible(voteView, false);
      setVisible(loginView, false);
      setVisible(dashboard, true);
      try {
        await loadGroups();
      } catch (error) {
        if (error instanceof ApiError && error.status === 401) {
          showLogin();
          return;
        }
        groupsElement.innerHTML = '<p class="empty-state is-error">Could not load poll groups.</p>';
      }
    }

    function showLogin() {
      setVisible(bootState, false);
      setVisible(voteView, false);
      setVisible(dashboard, false);
      setVisible(loginView, true);
      requestAnimationFrame(() => loginForm.querySelector<HTMLInputElement>('input[name="password"]')?.focus());
    }

    function renderPublicPoll(poll: Poll, voted: boolean) {
      byId<HTMLElement>('voteGroup').textContent = poll.groupTitle ?? 'Live poll';
      const status = byId<HTMLElement>('voteStatus');
      status.textContent = statusLabel(poll.status);
      status.className = `status-chip status-${poll.status}`;
      byId<HTMLElement>('voteQuestion').textContent = poll.question;
      const intro = byId<HTMLElement>('voteIntro');
      const results = byId<HTMLElement>('voteResults');
      voteForm.removeAttribute('aria-busy');
      voteForm.innerHTML = '';
      results.innerHTML = '';
      setMessage('voteMessage', '');

      if (poll.status === 'draft') {
        intro.textContent = 'This poll is being prepared. Check back when the host opens voting.';
        return;
      }
      if (poll.status === 'closed') {
        intro.textContent = 'Voting is closed. Here is how the room responded.';
        results.innerHTML = resultRows(poll);
        return;
      }
      if (voted) {
        intro.textContent = 'Your vote is recorded. Results will appear here when the host closes the poll.';
        return;
      }

      intro.textContent = 'Choose one option. Your browser can submit one vote for this poll.';
      voteForm.innerHTML = `
        <fieldset>
          <legend class="sr-only">Choose one option</legend>
          ${poll.options.map((option, index) => `
            <label class="vote-option">
              <input type="radio" name="optionId" value="${option.id}" ${index === 0 ? 'required' : ''} />
              <span class="option-index">${String(index + 1).padStart(2, '0')}</span>
              <span>${escapeHtml(option.label)}</span>
            </label>
          `).join('')}
        </fieldset>
        <button class="action action-primary vote-submit" type="submit">Cast vote <span aria-hidden="true">→</span></button>
      `;
    }

    async function showPublicPoll(code: string) {
      activeVoteCode = code.toUpperCase();
      setVisible(bootState, false);
      setVisible(loginView, false);
      setVisible(dashboard, false);
      setVisible(voteView, true);
      try {
        const data = await requestJson<{ poll: Poll; voted: boolean }>(`/api/polls/public/${encodeURIComponent(activeVoteCode)}`);
        renderPublicPoll(data.poll, data.voted);
      } catch (error) {
        byId<HTMLElement>('voteGroup').textContent = 'Polls';
        byId<HTMLElement>('voteStatus').textContent = 'Not found';
        byId<HTMLElement>('voteQuestion').textContent = 'This poll is not available.';
        byId<HTMLElement>('voteIntro').textContent = error instanceof ApiError && error.status === 404
          ? 'Check the short link or ask the host for a new QR code.'
          : 'The poll could not be loaded. Please try again.';
        voteForm.innerHTML = '';
        byId<HTMLElement>('voteResults').innerHTML = '';
      }
    }

    loginForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      setMessage('loginMessage', '');
      setBusy(loginForm, true);
      const formData = new FormData(loginForm);
      try {
        await requestJson('/api/polls/auth/login', {
          method: 'POST',
          body: JSON.stringify({
            username: formData.get('username'),
            password: formData.get('password'),
          }),
        });
        loginForm.querySelector<HTMLInputElement>('input[name="password"]')!.value = '';
        await showDashboard();
      } catch (error) {
        setMessage('loginMessage', error instanceof ApiError && error.status === 401
          ? 'Username or password is incorrect.'
          : 'Could not sign in. Please try again.', true);
      } finally {
        setBusy(loginForm, false);
      }
    });

    groupForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      setMessage('groupMessage', '');
      setBusy(groupForm, true);
      const formData = new FormData(groupForm);
      try {
        await requestJson('/api/polls/admin/groups', {
          method: 'POST',
          body: JSON.stringify({ title: formData.get('title') }),
        });
        groupForm.reset();
        await loadGroups();
      } catch (error) {
        setMessage('groupMessage', error instanceof ApiError ? error.message : 'Could not create group.', true);
      } finally {
        setBusy(groupForm, false);
      }
    });

    groupsElement.addEventListener('submit', async (event) => {
      const form = event.target as HTMLFormElement;
      if (!form.matches('.poll-form')) return;
      event.preventDefault();
      const message = form.querySelector<HTMLElement>('[data-poll-message]')!;
      message.textContent = '';
      message.classList.remove('is-error');
      setBusy(form, true);
      const formData = new FormData(form);
      const labels = String(formData.get('labels') ?? '').split(/\r?\n/).map((label) => label.trim()).filter(Boolean);
      try {
        await requestJson(`/api/polls/admin/groups/${form.dataset.groupId}/polls`, {
          method: 'POST',
          body: JSON.stringify({ question: formData.get('question'), labels }),
        });
        form.reset();
        await loadGroups();
      } catch (error) {
        message.textContent = error instanceof ApiError ? error.message : 'Could not create poll.';
        message.classList.add('is-error');
      } finally {
        setBusy(form, false);
      }
    });

    groupsElement.addEventListener('click', async (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button');
      if (!button) return;
      if (button.dataset.copyUrl) {
        try {
          await navigator.clipboard.writeText(button.dataset.copyUrl);
          const original = button.textContent;
          button.textContent = 'Copied';
          window.setTimeout(() => { button.textContent = original; }, 1400);
        } catch {
          window.prompt('Copy this poll link:', button.dataset.copyUrl);
        }
        return;
      }
      if (!button.dataset.pollId || !button.dataset.nextStatus) return;
      button.disabled = true;
      try {
        await requestJson(`/api/polls/admin/polls/${button.dataset.pollId}`, {
          method: 'PATCH',
          body: JSON.stringify({ status: button.dataset.nextStatus }),
        });
        await loadGroups();
      } catch (error) {
        window.alert(error instanceof ApiError ? error.message : 'Could not update poll.');
        button.disabled = false;
      }
    });

    voteForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const formData = new FormData(voteForm);
      const optionId = formData.get('optionId');
      if (!optionId) return;
      setBusy(voteForm, true);
      setMessage('voteMessage', 'Recording your vote...');
      try {
        await requestJson(`/api/polls/public/${encodeURIComponent(activeVoteCode)}/votes`, {
          method: 'POST',
          body: JSON.stringify({ optionId }),
        });
        await showPublicPoll(activeVoteCode);
      } catch (error) {
        if (error instanceof ApiError && error.status === 409) {
          await showPublicPoll(activeVoteCode);
          return;
        }
        setMessage('voteMessage', error instanceof ApiError ? error.message : 'Could not record vote.', true);
        setBusy(voteForm, false);
      }
    });

    byId<HTMLButtonElement>('refreshButton').addEventListener('click', async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      button.disabled = true;
      try {
        await loadGroups();
      } finally {
        button.disabled = false;
      }
    });

    byId<HTMLButtonElement>('logoutButton').addEventListener('click', async () => {
      try {
        await requestJson('/api/polls/auth/logout', { method: 'POST', body: '{}' });
      } finally {
        showLogin();
      }
    });

    async function initialize() {
      const voteCode = new URLSearchParams(location.search).get('vote');
      if (voteCode) {
        await showPublicPoll(voteCode);
        return;
      }
      try {
        const session = await requestJson<{ authenticated: boolean }>('/api/polls/auth/session');
        if (session.authenticated) await showDashboard();
        else showLogin();
      } catch {
        showLogin();
        setMessage('loginMessage', 'Poll administration is not configured yet.', true);
      }
    }

    void initialize();
  </script>
</Base>

<style is:global>
  .polls-page [hidden] { display: none !important; }
  .polls-page {
    position: relative;
    min-height: 100svh;
    padding: clamp(6.5rem, 13vh, 9rem) var(--page-padding) clamp(6rem, 12vh, 8rem);
    background:
      radial-gradient(circle at 94% 4%, var(--acid-soft) 0%, transparent 34%),
      radial-gradient(circle at 2% 92%, var(--acid-soft) 0%, transparent 30%),
      var(--bg);
  }
  .brand { display: inline-flex; align-items: center; gap: 0.6em; }
  .brand-mark { width: 1.6em; height: 1em; fill: var(--ink); }
  .boot-state,
  .noscript {
    position: relative;
    z-index: 2;
    max-width: 720px;
    margin: 12vh auto 0;
    text-align: center;
  }
  .boot-state p { margin-top: 1.5rem; color: var(--muted); }
  .panel {
    border: 1px solid var(--ink);
    background: color-mix(in srgb, var(--card) 92%, transparent);
    box-shadow: 8px 8px 0 var(--ink);
  }
  .login-view {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.7fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: center;
    max-width: 1120px;
    min-height: 60vh;
    margin: 0 auto;
  }
  .login-copy h1,
  .dashboard-heading h1 {
    font-family: var(--font-serif);
    font-size: var(--display-size);
    font-weight: 900;
    line-height: 0.92;
    letter-spacing: -0.04em;
    margin: 1.3rem 0;
  }
  .login-copy p,
  .dashboard-heading p {
    max-width: 52ch;
    color: var(--muted);
    font-family: var(--font-serif);
    font-size: var(--tagline-size);
    line-height: 1.5;
  }
  .login-form { padding: clamp(1.4rem, 3vw, 2.3rem); }
  .panel-heading,
  .group-heading,
  .eyebrow-row,
  .result-summary,
  .form-footer,
  .poll-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .panel-heading { border-bottom: 1px solid var(--rule); padding-bottom: 1rem; margin-bottom: 1.4rem; }
  .index-number,
  .group-count,
  .poll-code,
  .form-footer,
  .download-link {
    font-family: var(--font-mono);
    font-size: var(--label-size);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  label > span:first-child {
    display: block;
    margin-bottom: 0.45rem;
    font-family: var(--font-mono);
    font-size: var(--label-size);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  input,
  textarea {
    width: 100%;
    border: 1px solid var(--rule);
    border-radius: 0;
    background: var(--bg);
    color: var(--ink);
    font: inherit;
    padding: 0.85rem 0.95rem;
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  input:focus,
  textarea:focus { outline: none; border-color: var(--ink); box-shadow: 3px 3px 0 var(--acid-deep); }
  textarea { min-height: 7rem; resize: vertical; line-height: 1.45; }
  .login-form label { display: block; margin-bottom: 1.1rem; }
  .action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    min-height: 2.75rem;
    border: 1px solid var(--ink);
    border-radius: 0;
    padding: 0.65rem 1rem;
    background: transparent;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--label-size);
    letter-spacing: 0.12em;
    text-transform: uppercase;

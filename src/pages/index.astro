---
import Base from '../layouts/Base.astro';

const nav = [
  { n: '01', title: 'Talking', href: '/talking/', desc: 'Public talks & live sessions, out loud and on record.' },
  { n: '02', title: 'Writing', href: '/writing/', desc: 'Essays & field notes, and deeper research write-ups.' },
  { n: '03', title: 'Teaching', href: '/teaching/', desc: 'Courses & workshops, taught from first principles.' },
  { n: '04', title: 'CV', href: '/cv/', desc: 'Walk through 8+ years across the data lifecycle.' },
  { n: '05', title: 'Contact', href: '/contact/', desc: 'Email, socials, and how to reach me.' },
];
---

<Base>
  <main class="hero">
    <header class="rule-top">
      <span class="brand">
        <svg class="brand-mark" viewBox="0 0 64 40" aria-hidden="true">
          <rect x="2" y="26" width="10" height="12" rx="1.5"></rect>
          <rect x="18" y="16" width="10" height="22" rx="1.5"></rect>
          <rect x="34" y="8" width="10" height="30" rx="1.5"></rect>
          <rect x="50" y="2" width="10" height="36" rx="1.5"></rect>
        </svg>
        <span class="strong">h1sort.com</span>
      </span>
      <span>Mexico City</span>
    </header>

    <div class="hero-content">
      <div class="hero-lead">
        <span class="acid-label reveal d1">Data · Analytics · AI</span>

        <h1 class="hero-name reveal d2">
          {/* Split server-side so Astro's scoped-style attribute lands on each
              letter — runtime-created spans never get it, which silently killed
              the wave. --i offsets each letter into a different phase. */}
          <span class="first">{[...'Carlos'].map((ch, i) => (
            <span class="ltr" style={`--i:${i}`}>{ch}</span>
          ))}</span>
          <span class="last">Haro</span>
        </h1>

        <p class="hero-tagline reveal d3">
          <em>AI Engineer</em> &amp; <em>Technical Product Manager</em>. Eight years
          bridging deep technical execution and business strategy, shipping
          end-to-end <span class="marker">data &amp; AI</span> across AWS, Azure and GCP.
        </p>

      </div>

      <aside class="viz reveal d3" aria-label="Ambient clustering animation">
        <div class="viz-head">
          <span class="viz-live">Clustering...</span>
          <span class="viz-n" id="vizN">n = 128</span>
        </div>
        <canvas id="vizCanvas" class="viz-canvas"></canvas>
        <div class="viz-foot">
          <span class="viz-algo" id="vizAlgo">k-means · k = 4</span>
          <span class="viz-big" id="vizMetric">inertia 1.00</span>
        </div>
      </aside>
    </div>

    <nav class="index" aria-label="Site sections">
      {nav.map((item, i) => (
        <a class={`index-item reveal d${4 + i}`} href={item.href}>
          <span class="index-n">{item.n}</span>
          <span class="index-body">
            <span class="index-title">{item.title}</span>
            <span class="index-desc">{item.desc}</span>
          </span>
          <span class="index-arrow">→</span>
        </a>
      ))}
    </nav>

    <footer class="rule-bottom">
      <span class="foot-social">
        <a class="link" href="https://github.com/h1sort" target="_blank" rel="noopener noreferrer">GitHub</a>
        <span class="foot-sep">·</span>
        <a class="link" href="https://linkedin.com/in/h1sort" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <span class="foot-sep">·</span>
        <a class="link" href="https://x.com/h1sort" target="_blank" rel="noopener noreferrer">X</a>
      </span>
      <a class="link" href="mailto:carlos@h1sort.com">carlos@h1sort.com</a>
    </footer>
  </main>

<script>
  // ============================================================
  // Ambient clustering visualization
  // Cycles through k-means, a Gaussian mixture (EM) and DBSCAN over
  // the same generated blobs. Each algorithm emits a sequence of
  // frames; the renderer interpolates between them and draws the
  // outline style that algorithm asks for.
  // ============================================================

  type Pt = { x: number; y: number };
  // cov is [xx, xy, yy] per cluster; cents null means the algorithm has no
  // centroid to show (DBSCAN), which also suppresses the spokes.
  type Frame = { cents: Pt[] | null; covs: number[][] | null; assign: number[]; metric: number };
  // run() returns its own parameter label, so a value the algorithm derives
  // internally (DBSCAN's eps) isn't recomputed just to caption the panel.
  type Run = { frames: Frame[]; param: string };
  type Algo = {
    name: string;
    outline: 'hull' | 'ellipse';
    stepMs: number;
    format: (v: number) => string;
    run: (pts: Pt[], k: number, w: number, h: number) => Run;
  };
  type Shape = 'circle' | 'square' | 'triangle' | 'diamond' | 'cross';

  const canvas = document.getElementById('vizCanvas') as HTMLCanvasElement | null;

  // --- Geometry helpers ---
  const dist2 = (a: Pt, b: Pt) => (a.x - b.x) ** 2 + (a.y - b.y) ** 2;
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
  const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));
  const easeInOut = (t: number) => (t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2);

  // Box-Muller, so blobs look sampled rather than painted on
  function gauss(): number {
    let u = 0;
    while (u === 0) u = Math.random();
    return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * Math.random());
  }

  function makePoints(n: number, k: number, w: number, h: number): Pt[] {
    // Pick blob centres with a best-of-N spread so clusters stay separable
    const m = 0.16;
    const centres: Pt[] = [];
    for (let i = 0; i < k; i++) {
      let best: Pt = { x: w / 2, y: h / 2 };
      let bestD = -1;
      for (let t = 0; t < 40; t++) {
        const c = {
          x: m * w + Math.random() * (1 - 2 * m) * w,
          y: m * h + Math.random() * (1 - 2 * m) * h,
        };
        const d = centres.length
          ? Math.min(...centres.map((o) => Math.hypot(o.x - c.x, o.y - c.y)))
          : Infinity;
        if (d > bestD) { bestD = d; best = c; }
      }
      centres.push(best);
    }
    const spread = Math.min(w, h) * 0.09;
    const pts: Pt[] = [];
    for (let i = 0; i < n; i++) {
      const c = centres[i % k];
      pts.push({
        x: clamp(c.x + gauss() * spread, 5, w - 5),
        y: clamp(c.y + gauss() * spread, 5, h - 5),
      });
    }
    return pts;
  }

  // k-means++ seeding: each new seed is drawn with probability proportional to
  // its squared distance from the nearest existing seed. Plain random seeding
  // regularly settles into a bad local optimum: one cluster straddling two
  // blobs with its centroid in the empty gap, or a stranded EM component with
  // no points. The settled state is what's on screen longest, and it's what
  // reduced-motion visitors see permanently, so it has to be right.
  function seedPlusPlus(pts: Pt[], k: number): Pt[] {
    const seeds: Pt[] = [{ ...pts[Math.floor(Math.random() * pts.length)] }];
    while (seeds.length < k) {
      const d = pts.map((p) => Math.min(...seeds.map((s) => dist2(p, s))));
      const total = d.reduce((a, b) => a + b, 0);
      let r = Math.random() * total;
      let pick = d.length - 1;
      for (let i = 0; i < d.length; i++) {
        r -= d[i];
        if (r <= 0) { pick = i; break; }
      }
      seeds.push({ ...pts[pick] });
    }
    return seeds;
  }

  function nearest(p: Pt, cents: Pt[]): number {
    let bi = 0;
    let bd = Infinity;
    for (let i = 0; i < cents.length; i++) {
      const d = dist2(p, cents[i]);
      if (d < bd) { bd = d; bi = i; }
    }
    return bi;
  }

  // --- 1. Lloyd's algorithm ---
  function kmeans(pts: Pt[], k: number): Frame[] {
    let cents = seedPlusPlus(pts, k);
    const frames: Frame[] = [];
    // Report inertia as a fraction of the total variance about the global mean,
    // not of the first iteration's. A ratio against iteration 0 depends on how
    // lucky the seeding was, so a *perfect* clustering from a good seed scored
    // worse than a mediocre one from a bad seed.
    const gx = pts.reduce((s, p) => s + p.x, 0) / pts.length;
    const gy = pts.reduce((s, p) => s + p.y, 0) / pts.length;
    const total = pts.reduce((s, p) => s + dist2(p, { x: gx, y: gy }), 0) || 1;

    for (let step = 0; step < 7; step++) {
      const assign = pts.map((p) => nearest(p, cents));
      const inertia = pts.reduce((s, p, i) => s + dist2(p, cents[assign[i]]), 0);
      frames.push({ cents: cents.map((c) => ({ ...c })), covs: null, assign, metric: inertia / total });

      const next = cents.map((c, ci) => {
        let sx = 0, sy = 0, count = 0;
        for (let i = 0; i < pts.length; i++) {
          if (assign[i] === ci) { sx += pts[i].x; sy += pts[i].y; count++; }
        }
        return count ? { x: sx / count, y: sy / count } : { ...c };
      });
      const moved = next.reduce((s, c, i) => s + Math.hypot(c.x - cents[i].x, c.y - cents[i].y), 0);
      cents = next;
      // Stop as soon as the centroids have *visually* settled. Running to true
      // numerical convergence burns iterations on sub-pixel moves and starves
      // the converged state, which is the part worth looking at.
      if (moved < 1.5 && frames.length >= 2) break;
    }
    return frames;
  }

  // --- 2. Gaussian mixture, fitted by EM ---
  function gmm(pts: Pt[], k: number, w: number, h: number): Frame[] {
    const means = seedPlusPlus(pts, k);
    const s0 = (Math.min(w, h) * 0.1) ** 2;
    const ridge = (Math.min(w, h) * 0.02) ** 2; // keeps covariances invertible
    let covs = Array.from({ length: k }, () => [s0, 0, s0]);
    let weights = new Array(k).fill(1 / k);
    const frames: Frame[] = [];
    const n = pts.length;

    for (let step = 0; step < 9; step++) {
      // E step
      const resp: number[][] = [];
      let logL = 0;
      for (let i = 0; i < n; i++) {
        const row = new Array(k);
        let sum = 0;
        for (let c = 0; c < k; c++) {
          const [a, b, d] = covs[c];
          const det = Math.max(a * d - b * b, 1e-6);
          const dx = pts[i].x - means[c].x;
          const dy = pts[i].y - means[c].y;
          const quad = (d * dx * dx - 2 * b * dx * dy + a * dy * dy) / det;
          const p = weights[c] * Math.exp(-0.5 * quad) / (2 * Math.PI * Math.sqrt(det));
          row[c] = p;
          sum += p;
        }
        sum = Math.max(sum, 1e-300);
        logL += Math.log(sum);
        for (let c = 0; c < k; c++) row[c] /= sum;
        resp.push(row);
      }

      const assign = resp.map((row) => row.indexOf(Math.max(...row)));
      frames.push({
        cents: means.map((m) => ({ ...m })),
        covs: covs.map((c) => c.slice()),
        assign,
        metric: logL / n,
      });

      // M step
      let moved = 0;
      for (let c = 0; c < k; c++) {
        let nk = 0, mx = 0, my = 0;
        for (let i = 0; i < n; i++) { nk += resp[i][c]; mx += resp[i][c] * pts[i].x; my += resp[i][c] * pts[i].y; }
        if (nk < 1e-6) continue;
        const mean = { x: mx / nk, y: my / nk };
        moved += Math.hypot(mean.x - means[c].x, mean.y - means[c].y);
        means[c] = mean;
        let sxx = 0, sxy = 0, syy = 0;
        for (let i = 0; i < n; i++) {
          const dx = pts[i].x - means[c].x;
          const dy = pts[i].y - means[c].y;
          sxx += resp[i][c] * dx * dx;
          sxy += resp[i][c] * dx * dy;
          syy += resp[i][c] * dy * dy;
        }
        covs[c] = [sxx / nk + ridge, sxy / nk, syy / nk + ridge];
        weights[c] = nk / n;
      }
      // Same reasoning as k-means: stop once the means have visually settled.
      if (moved < 1.5 && frames.length >= 2) break;
    }
    return frames;
  }

  // --- 3. DBSCAN, animated as the clusters grow outward ---
  function autoEps(pts: Pt[], minPts: number): number {
    const ds = pts.map((p) => {
      const d = pts.map((q) => Math.hypot(p.x - q.x, p.y - q.y)).sort((a, b) => a - b);
      return d[Math.min(minPts, d.length - 1)];
    }).sort((a, b) => a - b);
    return ds[Math.floor(ds.length * 0.8)] * 1.15;
  }

  function dbscan(pts: Pt[], eps: number, minPts: number): Frame[] {
    const n = pts.length;
    const labels = new Array(n).fill(-1); // -1 = noise / not yet reached
    const visited = new Array(n).fill(false);
    const frames: Frame[] = [];
    const eps2 = eps * eps;
    const neighbours = (i: number) => {
      const out: number[] = [];
      for (let j = 0; j < n; j++) if (j !== i && dist2(pts[i], pts[j]) <= eps2) out.push(j);
      return out;
    };
    const snap = () =>
      frames.push({
        cents: null,
        covs: null,
        assign: labels.slice(),
        metric: labels.reduce((s: number, l: number) => s + (l < 0 ? 1 : 0), 0),
      });

    snap();
    let cid = 0;
    let since = 0;
    for (let i = 0; i < n; i++) {
      if (visited[i]) continue;
      visited[i] = true;
      const nb = neighbours(i);
      if (nb.length + 1 < minPts) continue;
      labels[i] = cid;
      const queue = nb.slice();
      const queued = new Set(queue);
      for (let qi = 0; qi < queue.length; qi++) {
        const j = queue[qi];
        if (!visited[j]) {
          visited[j] = true;
          const nb2 = neighbours(j);
          if (nb2.length + 1 >= minPts) {
            for (const x of nb2) if (!queued.has(x)) { queued.add(x); queue.push(x); }
          }
        }
        if (labels[j] < 0) {
          labels[j] = cid;
          if (++since >= 6) { since = 0; snap(); }
        }
      }
      cid++;
      snap();
    }
    snap();
    return frames;
  }

  const ALGOS: Algo[] = [
    {
      name: 'k-means',
      outline: 'hull',
      stepMs: 780,
      format: (v) => `inertia ${v.toFixed(2)}`,
      run: (pts, k) => ({ frames: kmeans(pts, k), param: `k = ${k}` }),
    },
    {
      name: 'gaussian mixture',
      outline: 'ellipse',
      stepMs: 700,
      format: (v) => `logL ${v.toFixed(2)}`,
      run: (pts, k, w, h) => ({ frames: gmm(pts, k, w, h), param: `k = ${k}` }),
    },
    {
      name: 'dbscan',
      outline: 'hull',
      stepMs: 130,
      format: (v) => `noise ${Math.round(v)}`,
      run: (pts) => {
        const minPts = 4;
        const eps = autoEps(pts, minPts);
        return { frames: dbscan(pts, eps, minPts), param: `eps = ${Math.round(eps)}` };
      },
    },
  ];

  // Monotone-chain convex hull
  function hull(ps: Pt[]): Pt[] {
    if (ps.length < 3) return ps;
    const p = ps.slice().sort((a, b) => a.x - b.x || a.y - b.y);
    const cross = (o: Pt, a: Pt, b: Pt) =>
      (a.x - o.x) * (b.y - o.y) - (a.y - o.y) * (b.x - o.x);
    const lower: Pt[] = [];
    for (const q of p) {
      while (lower.length >= 2 && cross(lower[lower.length - 2], lower[lower.length - 1], q) <= 0) lower.pop();
      lower.push(q);
    }
    const upper: Pt[] = [];
    for (let i = p.length - 1; i >= 0; i--) {
      const q = p[i];
      while (upper.length >= 2 && cross(upper[upper.length - 2], upper[upper.length - 1], q) <= 0) upper.pop();
      upper.push(q);
    }
    lower.pop();
    upper.pop();
    return lower.concat(upper);
  }

  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const css = (name: string) =>
      getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const nEl = document.getElementById('vizN');
    const algoEl = document.getElementById('vizAlgo');
    const metricEl = document.getElementById('vizMetric');

    // Phase durations (ms). Per-iteration time comes from the algorithm.
    const SEED = 700, OUTLINE = 950, HOLD = 2400, FADE = 700;

    // Clusters are told apart by value *and* mark shape, so the two-hue
    // editorial palette survives without inventing new brand colors.
    let palette: { color: string; shape: Shape }[] = [];
    let acid = '#c8ff3e';
    let ink = '#16140f';
    const inkRGB = '22, 20, 15'; // --ink, for the translucent spokes and outlines

    function readPalette() {
      acid = css('--acid') || acid;
      ink = css('--ink') || ink;
      palette = [
        { color: ink, shape: 'circle' },
        { color: css('--acid-deep') || '#a8e01f', shape: 'square' },
        { color: css('--muted') || '#6f6a5e', shape: 'triangle' },
        { color: css('--muted-soft') || '#9a9385', shape: 'diamond' },
        { color: css('--ink-soft') || '#2a261d', shape: 'cross' },
      ];
    }

    let pts: Pt[] = [];
    let frames: Frame[] = [];
    let algo: Algo = ALGOS[0];
    let algoIndex = 0;
    let started = 0;
    let raf = 0;
    let running = false;

    function shape(kind: Shape, x: number, y: number, r: number) {
      if (kind === 'cross') {
        // An x, drawn as a plus rotated a quarter turn
        ctx.save();
        ctx.translate(x, y);
        ctx.rotate(Math.PI / 4);
        ctx.beginPath();
        ctx.rect(-r * 1.25, -r * 0.34, r * 2.5, r * 0.68);
        ctx.rect(-r * 0.34, -r * 1.25, r * 0.68, r * 2.5);
        ctx.fill();
        ctx.restore();
        return;
      }
      ctx.beginPath();
      if (kind === 'circle') {
        ctx.arc(x, y, r, 0, Math.PI * 2);
      } else if (kind === 'square') {
        ctx.rect(x - r * 0.88, y - r * 0.88, r * 1.76, r * 1.76);
      } else if (kind === 'triangle') {
        ctx.moveTo(x, y - r * 1.15);
        ctx.lineTo(x + r, y + r * 0.75);
        ctx.lineTo(x - r, y + r * 0.75);
        ctx.closePath();
      } else {
        ctx.moveTo(x, y - r * 1.2);
        ctx.lineTo(x + r * 1.2, y);
        ctx.lineTo(x, y + r * 1.2);
        ctx.lineTo(x - r * 1.2, y);
        ctx.closePath();
      }
      ctx.fill();
    }

    function drawNoise(x: number, y: number, r: number, alpha: number) {
      ctx.globalAlpha = alpha * 0.55;
      ctx.strokeStyle = `rgba(${inkRGB}, 0.55)`;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.arc(x, y, r * 0.8, 0, Math.PI * 2);
      ctx.stroke();
    }

    function drawCentroid(c: Pt, alpha: number) {
      const r = 5.5;
      ctx.globalAlpha = alpha;
      ctx.fillStyle = acid;
      ctx.strokeStyle = ink;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.arc(c.x, c.y, r, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();
      // crosshair, so the centroid reads as a computed mark not just a dot
      ctx.beginPath();
      ctx.moveTo(c.x - r * 1.9, c.y);
      ctx.lineTo(c.x + r * 1.9, c.y);
      ctx.moveTo(c.x, c.y - r * 1.9);
      ctx.lineTo(c.x, c.y + r * 1.9);
      ctx.globalAlpha = alpha * 0.45;
      ctx.stroke();
      ctx.globalAlpha = 1;
    }

    // Both outline styles draw on with the same dash-offset sweep
    function strokeDashed(path: () => void, len: number, t: number) {
      ctx.setLineDash([len, len]);
      ctx.lineDashOffset = len * (1 - t);
      ctx.beginPath();
      path();
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.lineDashOffset = 0;
    }

    function drawHulls(assign: number[], t: number) {
      const groups = new Map<number, Pt[]>();
      for (let i = 0; i < pts.length; i++) {
        const a = assign[i];
        if (a < 0) continue;
        if (!groups.has(a)) groups.set(a, []);
        groups.get(a)!.push(pts[i]);
      }
      ctx.lineWidth = 1;
      ctx.strokeStyle = `rgba(${inkRGB}, 0.35)`;
      for (const mem of groups.values()) {
        if (mem.length < 3) continue;
        const h = hull(mem);
        const cx = mem.reduce((s, p) => s + p.x, 0) / mem.length;
        const cy = mem.reduce((s, p) => s + p.y, 0) / mem.length;
        // Push each vertex out from the centre so the outline clears the marks
        const pad = h.map((p) => {
          const dx = p.x - cx;
          const dy = p.y - cy;
          const len = Math.hypot(dx, dy) || 1;
          return { x: p.x + (dx / len) * 7, y: p.y + (dy / len) * 7 };
        });
        let per = 0;
        for (let i = 0; i < pad.length; i++) {
          const a = pad[i];
          const b = pad[(i + 1) % pad.length];
          per += Math.hypot(b.x - a.x, b.y - a.y);
        }
        strokeDashed(() => {
          ctx.moveTo(pad[0].x, pad[0].y);
          for (let i = 1; i < pad.length; i++) ctx.lineTo(pad[i].x, pad[i].y);
          ctx.closePath();
        }, per, t);
      }
    }

    // 2-sigma ellipse from each component's covariance
    function drawEllipses(cents: Pt[], covs: number[][], t: number) {
      ctx.lineWidth = 1;
      ctx.strokeStyle = `rgba(${inkRGB}, 0.35)`;
      for (let i = 0; i < cents.length; i++) {
        const [a, b, d] = covs[i];
        const tr = a + d;
        const diff = Math.sqrt(Math.max((a - d) ** 2 + 4 * b * b, 0));
        const l1 = Math.max((tr + diff) / 2, 1e-6);
        const l2 = Math.max((tr - diff) / 2, 1e-6);
        const angle = 0.5 * Math.atan2(2 * b, a - d);
        const rx = 2 * Math.sqrt(l1);
        const ry = 2 * Math.sqrt(l2);
        // Ramanujan's approximation, good enough for a dash length
        const per = Math.PI * (3 * (rx + ry) - Math.sqrt((3 * rx + ry) * (rx + 3 * ry)));
        strokeDashed(() => ctx.ellipse(cents[i].x, cents[i].y, rx, ry, angle, 0, Math.PI * 2), per, t);
      }
    }

    function render(elapsed: number) {
      const w = canvas!.clientWidth;
      const h = canvas!.clientHeight;
      ctx.clearRect(0, 0, w, h);
      if (!frames.length) return true;

      const last = frames.length - 1;
      const step = algo.stepMs;
      const iterEnd = SEED + frames.length * step;
      const outlineEnd = iterEnd + OUTLINE;
      const holdEnd = outlineEnd + HOLD;
      const cycleEnd = holdEnd + FADE;

      // Resolve the current phase into: which frame, how far through it, how
      // far the outlines have drawn, and a global fade for the hand-off.
      let idx = 0, t = 0, outT = 0, seedT = 1, fade = 1;
      if (elapsed < SEED) {
        seedT = elapsed / SEED;
      } else if (elapsed < iterEnd) {
        const e = elapsed - SEED;
        idx = Math.min(last, Math.floor(e / step));
        t = Math.min(1, (e % step) / step);
      } else if (elapsed < outlineEnd) {
        idx = last; t = 1;
        outT = (elapsed - iterEnd) / OUTLINE;
      } else if (elapsed < holdEnd) {
        idx = last; t = 1; outT = 1;
      } else {
        idx = last; t = 1; outT = 1;
        fade = 1 - (elapsed - holdEnd) / FADE;
      }

      const cur = frames[idx];
      const next = frames[Math.min(last, idx + 1)];
      const et = easeInOut(t);
      const cents = cur.cents
        ? cur.cents.map((c, i) => ({
            x: lerp(c.x, next.cents![i].x, et),
            y: lerp(c.y, next.cents![i].y, et),
          }))
        : null;
      const covs = cur.covs
        ? cur.covs.map((c, i) => c.map((v, j) => lerp(v, next.covs![i][j], et)))
        : null;

      // Reassignment lands at the start of a frame; crossfade it briefly so
      // points don't snap between clusters.
      const swap = Math.min(1, t / 0.3);
      const prev = frames[Math.max(0, idx - 1)];

      ctx.globalAlpha = 1;

      // Spokes: every point tethered to its centroid, fading as outlines take over
      const spoke = cents ? fade * seedT * (1 - outT) * 0.5 : 0;
      if (spoke > 0.01) {
        ctx.strokeStyle = `rgba(${inkRGB}, ${0.18 * spoke})`;
        ctx.lineWidth = 1;
        ctx.beginPath();
        for (let i = 0; i < pts.length; i++) {
          const a = cur.assign[i];
          if (a < 0) continue;
          const c = cents[a];
          ctx.moveTo(pts[i].x, pts[i].y);
          ctx.lineTo(c.x, c.y);
        }
        ctx.stroke();
      }

      if (outT > 0) {
        const ot = Math.min(1, outT) * fade;
        if (algo.outline === 'ellipse' && cents && covs) drawEllipses(cents, covs, ot);
        else drawHulls(cur.assign, ot);
      }

      // Points
      const r = 2.9;
      for (let i = 0; i < pts.length; i++) {
        const p = pts[i];
        const a = idx > 0 ? prev.assign[i] : cur.assign[i];
        const b = cur.assign[i];
        const grow = seedT < 1 ? easeInOut(clamp(seedT * 1.6 - (i / pts.length) * 0.6, 0, 1)) : 1;
        if (grow <= 0) continue;
        if (b < 0) {
          drawNoise(p.x, p.y, r * grow, fade);
          continue;
        }
        if (a !== b && a >= 0 && swap < 1) {
          ctx.globalAlpha = fade * (1 - swap);
          ctx.fillStyle = palette[a % palette.length].color;
          shape(palette[a % palette.length].shape, p.x, p.y, r * grow);
          ctx.globalAlpha = fade * swap;
        } else {
          ctx.globalAlpha = fade;
        }
        ctx.fillStyle = palette[b % palette.length].color;
        shape(palette[b % palette.length].shape, p.x, p.y, r * grow);
      }
      ctx.globalAlpha = 1;

      // Centroids ride in once the points have landed
      if (cents && seedT > 0.55) {
        const ca = fade * clamp((seedT - 0.55) / 0.45, 0, 1);
        for (const c of cents) drawCentroid(c, ca);
      }

      if (metricEl) {
        const shown = lerp(cur.metric, next.metric, et);
        metricEl.textContent = algo.format(shown);
      }

      return elapsed >= cycleEnd;
    }

    function fitCanvas() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = canvas!.clientWidth;
      const h = canvas!.clientHeight;
      canvas!.width = Math.round(w * dpr);
      canvas!.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function reset() {
      readPalette();
      fitCanvas();
      const w = canvas!.clientWidth;
      const h = canvas!.clientHeight;
      algo = ALGOS[algoIndex % ALGOS.length];
      algoIndex++;
      const k = 3 + Math.floor(Math.random() * 3);
      const n = clamp(Math.round((w * h) / 950), 60, 150);
      pts = makePoints(n, k, w, h);
      const out = algo.run(pts, k, w, h);
      frames = out.frames;
      started = 0;
      if (nEl) nEl.textContent = `n = ${n}`;
      if (algoEl) algoEl.textContent = `${algo.name} · ${out.param}`;
    }

    function frame(now: number) {
      if (!started) started = now;
      const done = render(now - started);
      if (done) reset();
      raf = requestAnimationFrame(frame);
    }

    function stop() {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
      running = false;
    }

    function play() {
      if (running) return;
      running = true;
      started = 0;
      raf = requestAnimationFrame(frame);
    }

    const settled = () => SEED + frames.length * algo.stepMs + OUTLINE;

    reset();

    if (reduced) {
      // Settle straight to the converged state, outlines drawn, no motion.
      render(settled());
    } else {
      // Only burn frames while the hero is actually on screen.
      const io = new IntersectionObserver(
        (entries) => {
          if (entries[0].isIntersecting) play();
          else stop();
        },
        { threshold: 0 },
      );
      io.observe(canvas);
    }

    let resizeTimer: number | undefined;
    window.addEventListener('resize', () => {
      if (resizeTimer) clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        reset();
        if (reduced) render(settled());
      }, 200);
    });
  }
</script>
</Base>


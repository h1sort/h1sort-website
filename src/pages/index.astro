---
import Base from '../layouts/Base.astro';

const nav = [
  { n: '01', title: 'Talking', href: '/talking/', desc: 'Public talks & live sessions, out loud and on record.' },
  { n: '02', title: 'Writing', href: '/writing/', desc: 'Essays & field notes, and deeper research write-ups.' },
  { n: '03', title: 'Teaching', href: '/teaching/', desc: 'Courses & workshops, taught from first principles.' },
  { n: '04', title: 'CV', href: '/cv/', desc: 'Walk through 8+ years across the data lifecycle.' },
  { n: '05', title: 'Contact', href: '/contact/', desc: 'Email, socials, and how to reach me.' },
];
---

<Base>
  <main class="hero">
    <header class="rule-top">
      <span class="brand">
        <svg class="brand-mark" viewBox="0 0 64 40" aria-hidden="true">
          <rect x="2" y="26" width="10" height="12" rx="1.5"></rect>
          <rect x="18" y="16" width="10" height="22" rx="1.5"></rect>
          <rect x="34" y="8" width="10" height="30" rx="1.5"></rect>
          <rect x="50" y="2" width="10" height="36" rx="1.5"></rect>
        </svg>
        <span class="strong">h1sort.com</span>
      </span>
      <span>Mexico City</span>
    </header>

    <div class="hero-content">
      <div class="hero-lead">
        <span class="acid-label reveal d1">Data · Analytics · AI</span>

        <h1 class="hero-name reveal d2">
          {/* Split server-side so Astro's scoped-style attribute lands on each
              letter — runtime-created spans never get it, which silently killed
              the wave. --i offsets each letter into a different phase. */}
          <span class="first">{[...'Carlos'].map((ch, i) => (
            <span class="ltr" style={`--i:${i}`}>{ch}</span>
          ))}</span>
          <span class="last">Haro</span>
        </h1>

        <p class="hero-tagline reveal d3">
          <em>AI Engineer</em> &amp; <em>Technical Product Manager</em>. Eight years
          bridging deep technical execution and business strategy, shipping
          end-to-end <span class="marker">data &amp; AI</span> across AWS, Azure and GCP.
        </p>

      </div>

      <aside class="viz reveal d3" aria-label="Ambient clustering animation">
        <div class="viz-head">
          <span class="viz-live"><span class="dot"></span>Clustering</span>
          <span class="viz-n" id="vizN">n = 128</span>
        </div>
        <canvas id="vizCanvas" class="viz-canvas"></canvas>
        <div class="viz-foot">
          <span class="viz-algo" id="vizAlgo">k-means · k = 4</span>
          <span class="viz-big" id="vizMetric">inertia 1.00</span>
        </div>
      </aside>
    </div>

    <nav class="index" aria-label="Site sections">
      {nav.map((item, i) => (
        <a class={`index-item reveal d${4 + i}`} href={item.href}>
          <span class="index-n">{item.n}</span>
          <span class="index-body">
            <span class="index-title">{item.title}</span>
            <span class="index-desc">{item.desc}</span>
          </span>
          <span class="index-arrow">→</span>
        </a>
      ))}
    </nav>

    <footer class="rule-bottom">
      <span class="foot-social">
        <a class="link" href="https://github.com/h1sort" target="_blank" rel="noopener noreferrer">GitHub</a>
        <span class="foot-sep">·</span>
        <a class="link" href="https://linkedin.com/in/h1sort" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <span class="foot-sep">·</span>
        <a class="link" href="https://x.com/h1sort" target="_blank" rel="noopener noreferrer">X</a>
      </span>
      <a class="link" href="mailto:carlos@h1sort.com">carlos@h1sort.com</a>
    </footer>
  </main>

<script>
  // ============================================================
  // Ambient k-means clustering visualization
  // Points are generated as blobs, then Lloyd's algorithm runs:
  // centroids glide between iterations, spokes re-wire as points
  // change hands, and convex hulls draw once it converges.
  // ============================================================

  type Pt = { x: number; y: number };
  type Iter = { cents: Pt[]; assign: number[]; inertia: number };
  type Shape = 'circle' | 'square' | 'triangle' | 'diamond' | 'plus';

  const canvas = document.getElementById('vizCanvas') as HTMLCanvasElement | null;

  // --- Geometry helpers ---
  const dist2 = (a: Pt, b: Pt) => (a.x - b.x) ** 2 + (a.y - b.y) ** 2;
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
  const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));
  const easeInOut = (t: number) => (t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2);

  // Box-Muller, so blobs look sampled rather than painted on
  function gauss(): number {
    let u = 0;
    while (u === 0) u = Math.random();
    return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * Math.random());
  }

  function makePoints(n: number, k: number, w: number, h: number): Pt[] {
    // Pick blob centres with a best-of-N spread so clusters stay separable
    const m = 0.16;
    const centres: Pt[] = [];
    for (let i = 0; i < k; i++) {
      let best: Pt = { x: w / 2, y: h / 2 };
      let bestD = -1;
      for (let t = 0; t < 40; t++) {
        const c = {
          x: m * w + Math.random() * (1 - 2 * m) * w,
          y: m * h + Math.random() * (1 - 2 * m) * h,
        };
        const d = centres.length
          ? Math.min(...centres.map((o) => Math.hypot(o.x - c.x, o.y - c.y)))
          : Infinity;
        if (d > bestD) { bestD = d; best = c; }
      }
      centres.push(best);
    }
    const spread = Math.min(w, h) * 0.09;
    const pts: Pt[] = [];
    for (let i = 0; i < n; i++) {
      const c = centres[i % k];
      pts.push({
        x: clamp(c.x + gauss() * spread, 5, w - 5),
        y: clamp(c.y + gauss() * spread, 5, h - 5),
      });
    }
    return pts;
  }

  function nearest(p: Pt, cents: Pt[]): number {
    let bi = 0;
    let bd = Infinity;
    for (let i = 0; i < cents.length; i++) {
      const d = dist2(p, cents[i]);
      if (d < bd) { bd = d; bi = i; }
    }
    return bi;
  }

  // Lloyd's algorithm, recording every iteration so playback can interpolate
  function lloyd(pts: Pt[], k: number): Iter[] {
    const pool = pts.slice();
    for (let i = pool.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [pool[i], pool[j]] = [pool[j], pool[i]];
    }
    let cents: Pt[] = pool.slice(0, k).map((p) => ({ x: p.x, y: p.y }));
    const iters: Iter[] = [];

    for (let step = 0; step < 7; step++) {
      const assign = pts.map((p) => nearest(p, cents));
      const inertia = pts.reduce((s, p, i) => s + dist2(p, cents[assign[i]]), 0);
      iters.push({ cents: cents.map((c) => ({ ...c })), assign, inertia });

      const next = cents.map((c, ci) => {
        let sx = 0, sy = 0, count = 0;
        for (let i = 0; i < pts.length; i++) {
          if (assign[i] === ci) { sx += pts[i].x; sy += pts[i].y; count++; }
        }
        return count ? { x: sx / count, y: sy / count } : { ...c };
      });
      const moved = next.reduce((s, c, i) => s + Math.hypot(c.x - cents[i].x, c.y - cents[i].y), 0);
      cents = next;
      // Stop as soon as the centroids have *visually* settled. Running to true
      // numerical convergence burns several iterations on sub-pixel moves and
      // starves the converged state, which is the part worth looking at.
      if (moved < 1.5 && iters.length >= 2) break;
    }
    return iters;
  }

  // Monotone-chain convex hull
  function hull(ps: Pt[]): Pt[] {
    if (ps.length < 3) return ps;
    const p = ps.slice().sort((a, b) => a.x - b.x || a.y - b.y);
    const cross = (o: Pt, a: Pt, b: Pt) =>
      (a.x - o.x) * (b.y - o.y) - (a.y - o.y) * (b.x - o.x);
    const lower: Pt[] = [];
    for (const q of p) {
      while (lower.length >= 2 && cross(lower[lower.length - 2], lower[lower.length - 1], q) <= 0) lower.pop();
      lower.push(q);
    }
    const upper: Pt[] = [];
    for (let i = p.length - 1; i >= 0; i--) {
      const q = p[i];
      while (upper.length >= 2 && cross(upper[upper.length - 2], upper[upper.length - 1], q) <= 0) upper.pop();
      upper.push(q);
    }
    lower.pop();
    upper.pop();
    return lower.concat(upper);
  }

  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const css = (name: string) =>
      getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const nEl = document.getElementById('vizN');
    const algoEl = document.getElementById('vizAlgo');
    const metricEl = document.getElementById('vizMetric');

    // Phase durations (ms). One full cycle then a fresh dataset.
    const SEED = 700, ITER = 780, HULL = 950, HOLD = 2400, FADE = 700;

    // Clusters are told apart by value *and* shape, so the two-hue
    // editorial palette survives without inventing new brand colors.
    let palette: { color: string; shape: Shape }[] = [];
    const inkRGB = '22, 20, 15'; // --ink, for the translucent spokes and hulls

    function readPalette() {
      palette = [
        { color: css('--ink') || '#16140f', shape: 'circle' },
        { color: css('--acid-deep') || '#a8e01f', shape: 'square' },
        { color: css('--muted') || '#6f6a5e', shape: 'triangle' },
        { color: css('--muted-soft') || '#9a9385', shape: 'diamond' },
        { color: css('--ink-soft') || '#2a261d', shape: 'plus' },
      ];
    }

    let pts: Pt[] = [];
    let iters: Iter[] = [];
    let k = 4;
    let started = 0;
    let raf = 0;
    let running = false;

    function shape(kind: Shape, x: number, y: number, r: number) {
      ctx.beginPath();
      if (kind === 'circle') {
        ctx.arc(x, y, r, 0, Math.PI * 2);
      } else if (kind === 'square') {
        ctx.rect(x - r * 0.88, y - r * 0.88, r * 1.76, r * 1.76);
      } else if (kind === 'triangle') {
        ctx.moveTo(x, y - r * 1.15);
        ctx.lineTo(x + r, y + r * 0.75);
        ctx.lineTo(x - r, y + r * 0.75);
        ctx.closePath();
      } else if (kind === 'diamond') {
        ctx.moveTo(x, y - r * 1.2);
        ctx.lineTo(x + r * 1.2, y);
        ctx.lineTo(x, y + r * 1.2);
        ctx.lineTo(x - r * 1.2, y);
        ctx.closePath();
      } else {
        ctx.rect(x - r * 1.2, y - r * 0.34, r * 2.4, r * 0.68);
        ctx.rect(x - r * 0.34, y - r * 1.2, r * 0.68, r * 2.4);
      }
      ctx.fill();
    }

    function drawCentroid(c: Pt, alpha: number) {
      const r = 5.5;
      ctx.globalAlpha = alpha;
      ctx.fillStyle = css('--acid') || '#c8ff3e';
      ctx.strokeStyle = css('--ink') || '#16140f';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.arc(c.x, c.y, r, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();
      // crosshair, so the centroid reads as a computed mark not just a dot
      ctx.beginPath();
      ctx.moveTo(c.x - r * 1.9, c.y);
      ctx.lineTo(c.x + r * 1.9, c.y);
      ctx.moveTo(c.x, c.y - r * 1.9);
      ctx.lineTo(c.x, c.y + r * 1.9);
      ctx.globalAlpha = alpha * 0.45;
      ctx.stroke();
      ctx.globalAlpha = 1;
    }

    function drawHulls(assign: number[], cents: Pt[], t: number) {
      ctx.lineWidth = 1;
      ctx.strokeStyle = `rgba(${inkRGB}, 0.35)`;
      for (let ci = 0; ci < cents.length; ci++) {
        const mem = pts.filter((_, i) => assign[i] === ci);
        if (mem.length < 3) continue;
        const h = hull(mem);
        // Push each vertex out from the centroid so the outline clears the marks
        const pad = h.map((p) => {
          const dx = p.x - cents[ci].x;
          const dy = p.y - cents[ci].y;
          const len = Math.hypot(dx, dy) || 1;
          return { x: p.x + (dx / len) * 7, y: p.y + (dy / len) * 7 };
        });
        let per = 0;
        for (let i = 0; i < pad.length; i++) {
          const a = pad[i];
          const b = pad[(i + 1) % pad.length];
          per += Math.hypot(b.x - a.x, b.y - a.y);
        }
        ctx.setLineDash([per, per]);
        ctx.lineDashOffset = per * (1 - t);
        ctx.beginPath();
        ctx.moveTo(pad[0].x, pad[0].y);
        for (let i = 1; i < pad.length; i++) ctx.lineTo(pad[i].x, pad[i].y);
        ctx.closePath();
        ctx.stroke();
      }
      ctx.setLineDash([]);
      ctx.lineDashOffset = 0;
    }

    function render(elapsed: number) {
      const w = canvas!.clientWidth;
      const h = canvas!.clientHeight;
      ctx.clearRect(0, 0, w, h);
      if (!iters.length) return true;

      const last = iters.length - 1;
      const iterEnd = SEED + iters.length * ITER;
      const hullEnd = iterEnd + HULL;
      const holdEnd = hullEnd + HOLD;
      const cycleEnd = holdEnd + FADE;

      // Resolve the current phase into: which iteration, how far through it,
      // how far the hulls have drawn, and a global fade for the hand-off.
      let idx = 0, t = 0, hullT = 0, seedT = 1, fade = 1;
      if (elapsed < SEED) {
        seedT = elapsed / SEED;
      } else if (elapsed < iterEnd) {
        const e = elapsed - SEED;
        idx = Math.min(last, Math.floor(e / ITER));
        t = Math.min(1, (e % ITER) / ITER);
      } else if (elapsed < hullEnd) {
        idx = last; t = 1;
        hullT = (elapsed - iterEnd) / HULL;
      } else if (elapsed < holdEnd) {
        idx = last; t = 1; hullT = 1;
      } else {
        idx = last; t = 1; hullT = 1;
        fade = 1 - (elapsed - holdEnd) / FADE;
      }

      const cur = iters[idx];
      const next = iters[Math.min(last, idx + 1)];
      const et = easeInOut(t);
      const cents = cur.cents.map((c, i) => ({
        x: lerp(c.x, next.cents[i].x, et),
        y: lerp(c.y, next.cents[i].y, et),
      }));

      // Reassignment lands at the start of an iteration; crossfade it briefly
      // so points don't snap between clusters.
      const swap = Math.min(1, t / 0.3);
      const prev = iters[Math.max(0, idx - 1)];

      ctx.globalAlpha = 1;

      // Spokes: every point tethered to its centroid, fading as hulls take over
      const spoke = fade * seedT * (1 - hullT) * 0.5;
      if (spoke > 0.01) {
        ctx.strokeStyle = `rgba(${inkRGB}, ${0.18 * spoke})`;
        ctx.lineWidth = 1;
        ctx.beginPath();
        for (let i = 0; i < pts.length; i++) {
          const c = cents[cur.assign[i]];
          ctx.moveTo(pts[i].x, pts[i].y);
          ctx.lineTo(c.x, c.y);
        }
        ctx.stroke();
      }

      if (hullT > 0) drawHulls(cur.assign, cents, Math.min(1, hullT) * fade);

      // Points
      const r = 2.9;
      for (let i = 0; i < pts.length; i++) {
        const p = pts[i];
        const a = idx > 0 ? prev.assign[i] : cur.assign[i];
        const b = cur.assign[i];
        const grow = seedT < 1 ? easeInOut(clamp(seedT * 1.6 - (i / pts.length) * 0.6, 0, 1)) : 1;
        if (grow <= 0) continue;
        if (a !== b && swap < 1) {
          ctx.globalAlpha = fade * (1 - swap);
          ctx.fillStyle = palette[a % palette.length].color;
          shape(palette[a % palette.length].shape, p.x, p.y, r * grow);
          ctx.globalAlpha = fade * swap;
        } else {
          ctx.globalAlpha = fade;
        }
        ctx.fillStyle = palette[b % palette.length].color;
        shape(palette[b % palette.length].shape, p.x, p.y, r * grow);
      }
      ctx.globalAlpha = 1;

      // Centroids ride in once the points have landed
      if (seedT > 0.55) {
        const ca = fade * clamp((seedT - 0.55) / 0.45, 0, 1);
        for (const c of cents) drawCentroid(c, ca);
      }

      // Inertia, normalised against the first pass so it reads as a descent
      if (metricEl) {
        const base = iters[0].inertia || 1;
        const shown = lerp(cur.inertia, next.inertia, et) / base;
        metricEl.textContent = `inertia ${shown.toFixed(2)}`;
      }

      return elapsed >= cycleEnd;
    }

    function fitCanvas() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = canvas!.clientWidth;
      const h = canvas!.clientHeight;
      canvas!.width = Math.round(w * dpr);
      canvas!.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function reset() {
      readPalette();
      fitCanvas();
      const w = canvas!.clientWidth;
      const h = canvas!.clientHeight;
      k = 3 + Math.floor(Math.random() * 3);
      const n = clamp(Math.round((w * h) / 950), 60, 150);
      pts = makePoints(n, k, w, h);
      iters = lloyd(pts, k);
      started = 0;
      if (nEl) nEl.textContent = `n = ${n}`;
      if (algoEl) algoEl.textContent = `k-means · k = ${k}`;
    }

    function frame(now: number) {
      if (!started) started = now;
      const done = render(now - started);
      if (done) reset();
      raf = requestAnimationFrame(frame);
    }

    function stop() {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
      running = false;
    }

    function play() {
      if (running) return;
      running = true;
      started = 0;
      raf = requestAnimationFrame(frame);
    }

    reset();

    if (reduced) {
      // Settle straight to the converged state, hulls drawn, no motion.
      render(SEED + iters.length * ITER + HULL);
    } else {
      // Only burn frames while the hero is actually on screen.
      const io = new IntersectionObserver(
        (entries) => {
          if (entries[0].isIntersecting) play();
          else stop();
        },
        { threshold: 0 },
      );
      io.observe(canvas);
    }

    let resizeTimer: number | undefined;
    window.addEventListener('resize', () => {
      if (resizeTimer) clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        reset();
        if (reduced) render(SEED + iters.length * ITER + HULL);
      }, 200);
    });
  }
</script>
</Base>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vh, 2.5rem);
    padding: clamp(4.5rem, 9vh, 6.5rem) var(--page-padding) clamp(4rem, 8vh, 5.5rem);
    background:
      radial-gradient(circle at var(--spot-x, 92%) var(--spot-y, 6%), rgba(200, 255, 62, 0.28) 0%, transparent 42%),
      radial-gradient(circle at var(--spot2-x, -6%) var(--spot2-y, 108%), rgba(200, 255, 62, 0.15) 0%, transparent 48%),
      var(--bg);
    animation:
      spot-drift 26s ease-in-out infinite alternate,
      spot-drift-2 34s ease-in-out infinite alternate;
  }

  @property --spot-x  { syntax: '<percentage>'; inherits: true; initial-value: 92%; }
  @property --spot-y  { syntax: '<percentage>'; inherits: true; initial-value: 6%; }
  @property --spot2-x { syntax: '<percentage>'; inherits: true; initial-value: -6%; }
  @property --spot2-y { syntax: '<percentage>'; inherits: true; initial-value: 108%; }
  @keyframes spot-drift {
    0%   { --spot-x: 105%; --spot-y: -8%; }
    50%  { --spot-x: 68%;  --spot-y: 26%; }
    100% { --spot-x: 94%;  --spot-y: -4%; }
  }
  @keyframes spot-drift-2 {
    0%   { --spot2-x: -8%; --spot2-y: 108%; }
    50%  { --spot2-x: 28%; --spot2-y: 72%; }
    100% { --spot2-x: 4%;  --spot2-y: 96%; }
  }

  .brand { display: inline-flex; align-items: center; gap: 0.6em; }
  .brand-mark { width: 1.6em; height: 1em; fill: var(--ink); }

  /* --- Hero main grid --- */
  .hero-content {
    position: relative;
    z-index: 2;
    flex: 1;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .hero-name {
    font-family: var(--font-serif);
    font-weight: 900;
    font-size: var(--display-large);
    line-height: 0.86;
    letter-spacing: -0.035em;
    margin: clamp(1rem, 2.5vh, 1.8rem) 0 0;
    font-variation-settings: "opsz" 144;
  }
  .hero-name .first, .hero-name .last { display: block; }
  .hero-name .last { font-style: italic; font-weight: 400; }

  /* Mirrored Fraunces carries only opsz (9–144) and wght (100–900) — the
     SOFT/WONK axes are not in the subset, so animating them does nothing.
     Both keyframes list the same axes in the same order so they interpolate. */
  .hero-name .first .ltr {
    display: inline-block;
    font-variation-settings: "opsz" 144, "wght" 900;
    animation: letter-wave 5s ease-in-out infinite;
    /* Spread the phase over ~1/3 of the cycle so the ripple reads as travelling */
    animation-delay: calc(var(--i, 0) * -0.26s);
  }
  @keyframes letter-wave {
    0%, 100% { font-variation-settings: "opsz" 144, "wght" 900; }
    50%      { font-variation-settings: "opsz" 12,  "wght" 520; }
  }
  .hero-name .last {
    animation: breathe 7s ease-in-out 1.2s infinite;
  }
  @keyframes breathe {
    0%, 100% { font-variation-settings: "opsz" 144, "wght" 400; }
    50%      { font-variation-settings: "opsz" 24,  "wght" 560; }
  }

  .hero-tagline {
    margin: clamp(1.2rem, 2.5vh, 2rem) 0 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 300;
    font-size: var(--tagline-size);
    line-height: 1.45;
    color: var(--muted);
    max-width: 40ch;
  }
  .hero-tagline em { color: var(--ink); font-style: normal; font-weight: 500; }

  /* --- Clustering visualization --- */
  .viz {
    align-self: center;
    width: 100%;
    border: 1px solid var(--rule);
    background: rgba(236, 229, 215, 0.5);
    backdrop-filter: blur(4px);
    padding: clamp(0.8rem, 1.6vw, 1.2rem);
    display: flex;
    flex-direction: column;
    gap: clamp(0.6rem, 1.2vh, 0.9rem);
  }
  .viz-head, .viz-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: var(--label-size);

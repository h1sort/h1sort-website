const pointPosition = (cost: number, score: number, minScore: number, maxScore: number) => {
  const plotWidth = chart.width - chart.left - chart.right;
  const plotHeight = chart.height - chart.top - chart.bottom;
  const xRatio = (Math.log10(cost) - Math.log10(chart.minCost)) /
    (Math.log10(chart.maxCost) - Math.log10(chart.minCost));
  const yRatio = (score - minScore) / (maxScore - minScore);
  return {
    x: chart.left + xRatio * plotWidth,
    y: chart.top + (1 - yRatio) * plotHeight,
  };
};


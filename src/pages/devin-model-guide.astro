  <script>
    const budgetInput = document.querySelector<HTMLInputElement>('#acu-budget');
    const rateInput = document.querySelector<HTMLInputElement>('#acu-rate');
    const usersInput = document.querySelector<HTMLInputElement>('#active-users');
    const policyNode = document.querySelector<HTMLScriptElement>('#policy-data');

    if (budgetInput && rateInput && usersInput && policyNode?.textContent) {
      const policy = JSON.parse(policyNode.textContent);
      const currency = new Intl.NumberFormat('en-US', {
        style: 'currency',
        currency: 'USD',
        maximumFractionDigits: 0,
      });
      const integer = new Intl.NumberFormat('en-US', { maximumFractionDigits: 0 });

      const updatePolicy = () => {
        const acuPerUser = Math.max(100, Number(budgetInput.value) || 100);
        const rate = Math.max(0.1, Number(rateInput.value) || 0.1);
        const users = Math.max(1, Number(usersInput.value) || 1);
        const organizationAcus = acuPerUser * users;
        const band = acuPerUser < 400 ? 'tight' : acuPerUser < 800 ? 'balanced' : 'generous';
        const profile = policy.budgetProfiles[band];
        const specialist = profile.shares.escalation + profile.shares.reserve;
        const usd = organizationAcus * rate;

        const setText = (selector: string, value: string) => {
          const node = document.querySelector<HTMLElement>(selector);
          if (node) node.textContent = value;
        };

        setText('#acu-budget-output', `${integer.format(acuPerUser)} ACUs`);
        setText('#budget-band', profile.label);
        setText('#budget-description', profile.description);
        setText('#organization-acus', integer.format(organizationAcus));
        setText('#budget-usd', currency.format(usd));
        setText('#acu-per-user', integer.format(acuPerUser));
        setText('#daily-share', `${integer.format(organizationAcus * profile.shares.daily / 100)} ACUs`);
        setText('#specialist-share', `${integer.format(organizationAcus * specialist / 100)} ACUs`);

        document.querySelectorAll<HTMLElement>('[data-model-guidance]').forEach((node) => {
          const model = node.dataset.modelGuidance;
          if (model) node.textContent = policy.modelBandGuidance[model][band];
        });

        document.querySelectorAll<HTMLElement>('[data-role-guidance]').forEach((node) => {
          const role = node.dataset.roleGuidance;
          if (role) node.textContent = policy.roleGuidance[role][band];
        });
      };

      budgetInput.addEventListener('input', updatePolicy);
      rateInput.addEventListener('input', updatePolicy);
      usersInput.addEventListener('input', updatePolicy);
      updatePolicy();
    }

    const benchmarkButtons = document.querySelectorAll<HTMLButtonElement>('[data-benchmark-select]');
    const benchmarkCharts = document.querySelectorAll<SVGElement>('[data-benchmark-chart]');
    const benchmarkSource = document.querySelector<HTMLAnchorElement>('#benchmark-source');
    const benchmarkNote = document.querySelector<HTMLElement>('#benchmark-note');

    benchmarkButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const selected = button.dataset.benchmarkSelect;
        if (!selected) return;

        benchmarkButtons.forEach((candidate) => {
          candidate.setAttribute('aria-pressed', String(candidate === button));
        });
        benchmarkCharts.forEach((chartNode) => {
          chartNode.toggleAttribute('hidden', chartNode.dataset.benchmarkChart !== selected);
        });

        const label = button.dataset.benchmarkLabel;
        const source = button.dataset.benchmarkSource;
        const note = button.dataset.benchmarkNote;
        if (benchmarkSource && source) benchmarkSource.href = source;
        if (benchmarkSource && label) benchmarkSource.textContent = `Open ${label} ↗`;
        if (benchmarkNote && note) benchmarkNote.textContent = note;
      });
    });
  </script>

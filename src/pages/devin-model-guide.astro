    result: 'At 1M GraphWalks: Sol 77.1 · Terra 71.2 · Opus 4.8 68.1 · Luna 51.2. Luna also trails sharply on MRCR above 256K.',
    use: 'Large context is a concrete escalation trigger, not a reason to expose every model.',
    source: 'https://openai.com/index/gpt-5-6/',
    sourceLabel: 'GPT-5.6 evaluation table',
  },
  {
    family: 'Documents',
    benchmark: 'gdp.pdf',
    signal: 'Reasoning over complex visual PDF artifacts.',
    result: 'Sol 30.7 · Fable 29.8 · Terra 24.7 · Luna 22.7 · Opus 4.8 22.5',
    use: 'Relevant to analysts and technical product managers handling dense reports.',
    source: 'https://openai.com/index/gpt-5-6/',
    sourceLabel: 'GPT-5.6 evaluation table',
  },
  {
    family: 'Multimodal',
    benchmark: 'MMMU Pro with tools',
    signal: 'Expert visual reasoning with tool access.',
    result: 'Sol 84.6 · Terra 82.0 · Luna 79.5 · GPT-5.5 83.2',
    use: 'Luna is often sufficient, but it is not the best choice for the hardest visual analysis.',
    source: 'https://openai.com/index/gpt-5-6/',
    sourceLabel: 'GPT-5.6 evaluation table',
  },
  {
    family: 'External audit',
    benchmark: 'METR Time Horizon 1.1',
    signal: 'Autonomous software-task duration and evaluation integrity.',
    result: 'METR declined to treat its Sol time-horizon estimates as robust because outcomes depended heavily on how detected evaluation exploits were scored.',
    use: 'Critical caveat: benchmark scores are not a substitute for trace review, guardrails, and internal evals.',
    source: 'https://metr.org/blog/2026-06-26-gpt-5-6-sol/',
    sourceLabel: 'METR evaluation',
  },
];

const adminSteps = [
  {
    n: '01',
    title: 'Group by work, not seniority alone',
    body: 'Map IdP groups to role families. Keep AI and research separate from BI, product, and general engineering because their justified frontier access differs.',
  },
  {
    n: '02',
    title: 'Filter by exact model',
    body: 'Use Devin Models Configuration by model, not by provider. A provider-wide OpenAI filter would also expose lower Luna, Terra XHigh, and Sol Medium.',
  },
  {
    n: '03',
    title: 'Override the default',
    body: 'Set GPT-5.6 Luna Extra High as the team default. Devin preselects the configured default whenever a user opens the product.',
  },
  {
    n: '04',
    title: 'Keep approval models out of the base group',
    body: 'Grant frontier access through a small exception group or a time-bounded admin change. If the tenant cannot expire access, review membership weekly.',
  },
  {
    n: '05',
    title: 'Measure outcomes, not token volume',
    body: 'Track model, spend, task class, first-pass acceptance, rework, latency, and human review. Revoke a model when its quality delta does not cover its cost delta.',
  },
];

const userWorkflow = [
  {
    step: 'Frame',
    body: 'State the artifact, constraints, acceptance tests, and stopping condition. One task per session.',
  },
  {
    step: 'Run Luna',
    body: 'Use Luna XHigh for the first bounded attempt. Ask it to verify the artifact, not merely explain what it would do.',
  },
  {
    step: 'Inspect',
    body: 'Run deterministic tests and review evidence. A failed outcome is a signal; model confidence is not.',
  },
  {
    step: 'Escalate once',
    body: 'Move only the unresolved ambiguity to the role-approved specialist. Preserve the original prompt, trace, and failure.',
  },
  {
    step: 'Return to Luna',
    body: 'Once the hard decision is resolved, hand bounded implementation and verification back to Luna.',
  },
];

const budgetProfiles = {
  tight: {
    label: 'Tight',
    description: 'Less than 400 ACUs per active user. Centralize specialist access and protect the Luna default.',
    shares: { daily: 85, escalation: 10, reserve: 5 },
  },
  balanced: {
    label: 'Balanced',
    description: '400–799 ACUs per active user. Self-serve the role workhorses and require triggers for frontier models.',
    shares: { daily: 75, escalation: 15, reserve: 10 },
  },
  generous: {
    label: 'Generous',
    description: '800 or more ACUs per active user. Expand specialist access, but preserve role boundaries and eval gates.',
    shares: { daily: 65, escalation: 20, reserve: 15 },
  },
};

const modelBandGuidance = {
  luna: {
    tight: 'Default for every role',
    balanced: 'Default for every role',
    generous: 'Default for every role',
  },
  swe: {
    tight: 'Builders during promo',
    balanced: 'Builders, then reprice',
    generous: 'Builders, then reprice',
  },
  terra: {
    tight: 'Shared exception when available',
    balanced: 'Role allowlist when available',
    generous: 'Role allowlist when available',
  },
  sol: {
    tight: 'Central exception only',
    balanced: 'Approval triggers',
    generous: 'Senior role allowlist',
  },
  opus: {
    tight: 'Central AI and code queue',
    balanced: 'AI and research allowlist',
    generous: 'Senior builder allowlist',
  },
  fable: {
    tight: 'Exceptional research only',
    balanced: 'AI and research approval',
    generous: 'AI and research reserve',
  },
};

const costComparisonModels = decisionModels.filter((model) => model.id !== 'swe');
const lunaFrontierCost = decisionModels.find((model) => model.id === 'luna')?.frontierCost ?? 0.299;
const policyData = {
  budgetProfiles,
  modelBandGuidance,
  roleGuidance: Object.fromEntries(roles.map((role) => [role.id, role.guidance])),
};
---

<Base
  title="Devin Model Guide · h1sort"
  description="An evidence-backed Devin Desktop model policy: role allowlists, escalation workflows, benchmark coverage, and a dynamic ACU budget planner."
  path="/devin-model-guide"
>
  <main class="guide">
    <header class="rule-top guide-rule">
      <a class="brand link" href="/">
        <svg class="brand-mark" viewBox="0 0 64 40" aria-hidden="true">
          <rect x="2" y="26" width="10" height="12" rx="1.5"></rect>
          <rect x="18" y="16" width="10" height="22" rx="1.5"></rect>
          <rect x="34" y="8" width="10" height="30" rx="1.5"></rect>
          <rect x="50" y="2" width="10" height="36" rx="1.5"></rect>
        </svg>
        <span class="strong">h1sort.com</span>
      </a>
      <span>Field note · {updated}</span>
    </header>

    <section class="hero section-shell">
      <div class="hero-copy">
        <span class="acid-label reveal d1">Devin model guide</span>
        <h1 class="reveal d2">Buy the <span class="marker">outcome</span>, not the model.</h1>
        <p class="hero-lede reveal d3">
          A role-based policy for choosing OpenAI, Anthropic, and SWE workhorses in
          Devin Desktop. Start with Luna at the highest deployable effort, then pay
          for additional intelligence only when a measured workflow needs it.
        </p>
      </div>

      <aside class="verdict reveal d4" aria-label="Policy verdict">
        <span class="mono-label">Default policy</span>
        <strong>Luna XHigh first.</strong>
        <p>
          Disable lower Luna, Terra XHigh, and Sol Medium. Add SWE-1.7 for builders.
          Gate Sol High and Opus Medium. Keep Fable out of BI and ordinary engineering.
        </p>
        <a class="btn" href="#policy">See the allowlists <span class="arrow">↓</span></a>
      </aside>
    </section>

    <nav class="jump-nav section-shell reveal d5" aria-label="Guide sections">
      <a href="#budget">Budget</a>
      <a href="#frontier">Cost frontier</a>
      <a href="#policy">Roles</a>
      <a href="#workflows">Workflows</a>
      <a href="#evidence">Evidence</a>
      <a href="#method">Method</a>
    </nav>

    <section id="budget" class="section-shell section-block">
      <div class="section-heading reveal">
        <span class="section-index">01</span>
        <div>
          <span class="mono-label">Dynamic policy</span>
          <h2>Put a budget around the decision.</h2>
          <p>
            The starting contract is 800 monthly ACUs per active user at $2 per ACU.
            Active users scale the organization ceiling, while the per-user allowance
            determines the recommended access posture.
          </p>
        </div>
      </div>

      <div class="budget-panel reveal">
        <div class="controls">
          <label class="control" for="acu-budget">
            <span>Monthly ACUs per active user</span>
            <output id="acu-budget-output" for="acu-budget">{defaultAcuPerUser} ACUs</output>
            <input id="acu-budget" type="range" min="100" max="5000" step="50" value={defaultAcuPerUser} />
          </label>

          <label class="control" for="acu-rate">
            <span>Contract rate per ACU</span>
            <span class="number-wrap"><span>$</span><input id="acu-rate" type="number" min="0.1" max="20" step="0.1" value={defaultAcuRate} /></span>
          </label>

          <label class="control" for="active-users">
            <span>Monthly active users</span>
            <span class="number-wrap"><input id="active-users" type="number" min="1" max="100000" step="100" value={defaultUsers} /><span>users</span></span>
          </label>
        </div>

        <div class="budget-result" aria-live="polite">
          <span class="mono-label">Current posture</span>
          <strong id="budget-band">Generous</strong>
          <p id="budget-description">{budgetProfiles.generous.description}</p>
          <dl class="budget-stats">
            <div>
              <dt>Organization ACUs</dt>
              <dd id="organization-acus">1,600,000</dd>
            </div>
            <div>
              <dt>Monthly value</dt>
              <dd id="budget-usd">$3,200,000</dd>
            </div>
            <div>
              <dt>ACUs / active user</dt>
              <dd id="acu-per-user">800</dd>
            </div>
            <div>
              <dt>Daily lane</dt>
              <dd id="daily-share">1,040,000 ACUs</dd>
            </div>
            <div>
              <dt>Escalation + reserve</dt>
              <dd id="specialist-share">560,000 ACUs</dd>
            </div>
          </dl>
        </div>
      </div>

      <div class="capacity-grid" aria-label="Relative benchmark task cost">
        {costComparisonModels.map((model) => {
          const relativeCost = model.frontierCost / lunaFrontierCost;
          return <article class="capacity-card">
            <span>{model.short}</span>
            <strong>{relativeCost === 1 ? '1×' : `${relativeCost.toFixed(1)}×`} Luna</strong>
            <small>${model.frontierCost.toFixed(2)} average per FrontierCode task</small>
          </article>;
        })}
      </div>
      <p class="caveat">
        FrontierCode reports the average API cost of completing one task in its harness.
        These ratios compare each selected model point with Luna XHigh. They are benchmark cost
        ratios, not Devin capacity or invoice forecasts.
      </p>
    </section>

    <section id="frontier" class="section-shell section-block">
      <div class="section-heading reveal">
        <span class="section-index">02</span>
        <div>
          <span class="mono-label">Interactive benchmark explorer</span>
          <h2>Remove dominated choices first.</h2>
          <p>
            Switch the score on the y-axis while keeping average API cost per completed task
            on the same logarithmic x-axis. Max benchmark points are not presented as Devin picker options.
          </p>
        </div>
      </div>

      <div class="benchmark-toolbar reveal">
        <div class="benchmark-tabs" role="group" aria-label="Select benchmark">
          {benchmarkPlots.map((plot, index) => (
            <button
              type="button"
              data-benchmark-select={plot.id}
              data-benchmark-source={plot.source}
              data-benchmark-label={plot.label}
              data-benchmark-note={plot.note}
              aria-controls={`benchmark-chart-${plot.id}`}
              aria-pressed={index === 0 ? 'true' : 'false'}
            >
              {plot.label}
            </button>
          ))}
        </div>
        <a id="benchmark-source" class="link" href={benchmarkPlots[0].source} target="_blank" rel="noopener noreferrer">
          Open {benchmarkPlots[0].label} ↗
        </a>
      </div>
      <p id="benchmark-note" class="benchmark-note" aria-live="polite">{benchmarkPlots[0].note}</p>

      <figure class="frontier-figure reveal">
        <div class="chart-scroll">
          {benchmarkPlots.map((plot, index) => {
            const pointMap = new Map(plot.points.map((point) => [point.name, point]));
            return (
              <svg
                id={`benchmark-chart-${plot.id}`}
                data-benchmark-chart={plot.id}
                viewBox={`0 0 ${chart.width} ${chart.height}`}
                role="img"
                aria-labelledby={`benchmark-title-${plot.id} benchmark-desc-${plot.id}`}
                hidden={index !== 0}
              >
                <title id={`benchmark-title-${plot.id}`}>{plot.label} score versus average API cost per completed task</title>
                <desc id={`benchmark-desc-${plot.id}`}>A logarithmic cost and score scatter plot for {plot.label}, limited to OpenAI, Anthropic, and SWE models relevant to this policy.</desc>

                {plot.scoreTicks.map((tick) => {
                  const { y } = pointPosition(chart.minCost, tick, plot.minScore, plot.maxScore);
                  return (
                    <g>
                      <line class="grid-line" x1={chart.left} x2={chart.width - chart.right} y1={y} y2={y}></line>
                      <text class="axis-text" x={chart.left - 14} y={y + 4} text-anchor="end">{tick}%</text>
                    </g>
                  );
                })}

                {costTicks.map((tick) => {
                  const { x } = pointPosition(tick, plot.minScore, plot.minScore, plot.maxScore);
                  return (
                    <g>
                      <line class="grid-line" x1={x} x2={x} y1={chart.top} y2={chart.height - chart.bottom}></line>
                      <text class="axis-text" x={x} y={chart.height - chart.bottom + 24} text-anchor="middle">${tick}</text>
                    </g>
                  );
                })}

                <text class="axis-label" x={(chart.left + chart.width - chart.right) / 2} y={chart.height - 10} text-anchor="middle">Average API cost per completed benchmark task, logarithmic scale</text>
                <text class="axis-label" transform={`translate(18 ${(chart.top + chart.height - chart.bottom) / 2}) rotate(-90)`} text-anchor="middle">{plot.yLabel}</text>

                {plot.comparisons.map((comparison) => {
                  const winnerPoint = pointMap.get(comparison.winner);
                  const comparedPoint = pointMap.get(comparison.compared);
                  if (!winnerPoint || !comparedPoint) return null;

                  const winner = pointPosition(winnerPoint.cost, winnerPoint.score, plot.minScore, plot.maxScore);
                  const compared = pointPosition(comparedPoint.cost, comparedPoint.score, plot.minScore, plot.maxScore);
                  const labelX = (winner.x + compared.x) / 2;
                  const labelY = comparison.kind === 'strict'
                    ? Math.max(winner.y, compared.y) + 31
                    : Math.min(winner.y, compared.y) - 35;

                  return (
                    <g class={`dominance-comparison comparison-${comparison.kind}`}>
                      <line class="comparison-guide" x1={winner.x} x2={winner.x} y1={winner.y} y2={chart.height - chart.bottom}></line>
                      <line class="comparison-guide" x1={compared.x} x2={compared.x} y1={compared.y} y2={chart.height - chart.bottom}></line>
                      <path class="comparison-elbow" d={`M ${winner.x} ${winner.y} H ${compared.x} V ${compared.y}`}></path>
                      <text class="comparison-copy" x={labelX} y={labelY} text-anchor="middle">
                        <tspan x={labelX}>{comparison.title}</tspan>
                        <tspan class="comparison-detail" x={labelX} dy="14">{comparison.detail}</tspan>
                      </text>
                    </g>
                  );
                })}

                {plot.points.map((point) => {
                  const { x, y } = pointPosition(point.cost, point.score, plot.minScore, plot.maxScore);
                  const defaultAnchor = x > 760 ? 'end' : 'start';
                  const anchor = 'labelAnchor' in point ? point.labelAnchor : defaultAnchor;
                  const defaultLabelX = x > 760 ? x - 10 : x + 10;
                  const labelX = 'labelDx' in point ? x + point.labelDx : defaultLabelX;
                  const labelY = y + ('labelDy' in point ? point.labelDy : -11);
                  return (
                    <g class={`point point-${point.state}`}>
                      <title>{point.name}: {point.score}% at ${point.cost.toFixed(2)} per {plot.label} task</title>
                      <circle cx={x} cy={y} r="7"></circle>
                      <text x={labelX} y={labelY} text-anchor={anchor}>{point.name}</text>
                    </g>
                  );
                })}
              </svg>
            );
          })}
        </div>
        <figcaption>
          <span><i class="legend allow"></i> Deployable policy point</span>
          <span><i class="legend benchmark"></i> Benchmark-only Max point</span>
          <span><i class="legend dominated"></i> Dominated</span>
          <span><i class="legend reserve"></i> Frontier reserve</span>
          <span><i class="legend comparison"></i> Dominance comparison</span>
        </figcaption>
      </figure>
      <p class="caveat">
        Every view uses the same x-axis definition and $0.20–$30 scale. A model can move
        horizontally because each benchmark harness generates different token usage and task cost.
      </p>

      <div class="model-grid">
        {decisionModels.map((model) => (
          <article class={`model-card model-${model.id}`}>
            <div class="model-topline">
              <span>{model.lane}</span>
              <span class="model-band" data-model-guidance={model.id}>{modelBandGuidance[model.id as keyof typeof modelBandGuidance].generous}</span>
            </div>
            <h3>{model.name}</h3>
            <dl>
              <div><dt>Input / output</dt><dd>{model.price}</dd></div>
              <div><dt>FC score / task</dt><dd>{model.frontierScore.toFixed(1)} / ${model.frontierCost.toFixed(2)}</dd></div>
            </dl>
            <p>{model.note}</p>
          </article>
        ))}
      </div>

      <div class="dominated-list">
        {dominatedChoices.map((item) => (
          <article>
            <h3>{item.choice}</h3>
            <p>{item.evidence}</p>
            <strong>{item.action}</strong>
          </article>
        ))}
      </div>
    </section>

    <section id="policy" class="section-shell section-block">
      <div class="section-heading reveal">
        <span class="section-index">03</span>
        <div>
          <span class="mono-label">Role policy</span>
          <h2>Small picker, explicit ladder.</h2>
          <p>
            Self-serve models belong in the base role group. Approval models stay out of that
            group until the trigger is met. Denied models are not visible in the picker.
          </p>
        </div>
      </div>

      <div class="role-list">
        {roles.map((role) => (
          <details class="role-card" data-role={role.id}>
            <summary>
              <span class="role-name">{role.role}</span>
              <span class="role-default"><small>Default</small>{role.defaultModel}</span>
              <span class="details-toggle" aria-hidden="true">+</span>
            </summary>
            <div class="role-body">
              <dl class="access-grid">
                <div class="access-allow"><dt>Self-serve</dt><dd>{role.selfServe}</dd></div>
                <div class="access-approval"><dt>Approval</dt><dd>{role.approval}</dd></div>
                <div class="access-deny"><dt>Deny</dt><dd>{role.deny}</dd></div>
              </dl>
              <div class="role-trigger">
                <span>Escalation trigger</span>
                <p>{role.triggers}</p>
              </div>
              <ul class="workflow-list">
                {role.workflows.map((workflow) => <li>{workflow}</li>)}
              </ul>
              <p class="role-budget">
                <span>Budget-adjusted guidance</span>
                <strong data-role-guidance={role.id}>{role.guidance.generous}</strong>
              </p>
            </div>
          </details>
        ))}
      </div>
    </section>

    <section id="workflows" class="section-shell section-block two-column-section">
      <div class="section-heading reveal">
        <span class="section-index">04</span>
        <div>
          <span class="mono-label">Operating guide</span>
          <h2>For admins and users.</h2>
          <p>A model policy works only when access, escalation, and measurement reinforce each other.</p>
        </div>
      </div>

      <div class="admin-guide">
        <div class="subheading">
          <span class="acid-label">Admin blueprint</span>
          <a class="link" href="https://docs.devin.ai/desktop/guide-for-admins" target="_blank" rel="noopener noreferrer">Devin admin docs ↗</a>
        </div>
        <ol class="step-list">
          {adminSteps.map((step) => (
            <li>
              <span>{step.n}</span>
              <div><h3>{step.title}</h3><p>{step.body}</p></div>
            </li>
          ))}
        </ol>
      </div>

      <div class="user-guide">
        <div class="subheading">
          <span class="acid-label">User loop</span>
          <span class="mono-label">One escalation, then back down</span>
        </div>
        <ol class="workflow-track">
          {userWorkflow.map((item, index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div><h3>{item.step}</h3><p>{item.body}</p></div>
            </li>
          ))}
        </ol>

        <div class="cli-card">
          <div>
            <span class="mono-label">Repeatable Luna profile</span>
            <p>Use the exact deployable default for bounded research and implementation tasks.</p>
          </div>
          <pre><code>codex \
  -m gpt-5.6-luna \
  -c 'model_reasoning_effort="xhigh"' \
  -c 'service_tier="fast"' \
  exec --ephemeral --json \
  '&lt;bounded task&gt;'</code></pre>
        </div>
      </div>

      <div class="review-loop">
        <span class="mono-label">Monthly policy review</span>
        <div class="review-metrics">
          <span>First-pass acceptance</span>
          <span>Human rework minutes</span>
          <span>Cost per accepted artifact</span>
          <span>Escalation rate</span>
          <span>Failed-test recovery</span>
          <span>Policy exceptions</span>
        </div>
        <p>
          Promote a model only after at least 30 representative tasks show a material outcome gain.
          Retire it when the 95% interval includes no gain or when rework cancels the apparent benchmark advantage.
        </p>
      </div>
    </section>

    <section id="evidence" class="section-shell section-block">
      <div class="section-heading reveal">
        <span class="section-index">05</span>
        <div>
          <span class="mono-label">Evidence register</span>
          <h2>Many signals, no magic average.</h2>
          <p>
            Scores are kept in their native units and tied to the work they measure.
            A single blended intelligence score would hide the role-specific failures that matter.
          </p>
        </div>
      </div>

      <div class="evidence-table-wrap">
        <table class="evidence-table">
          <thead>
            <tr>
              <th>Work</th>
              <th>Benchmark and signal</th>
              <th>Current result</th>
              <th>Policy use</th>
              <th>Source</th>
            </tr>
          </thead>
          <tbody>
            {benchmarkEvidence.map((item) => (
              <tr>
                <td>{item.family}</td>
                <td>
                  <a class="evidence-benchmark" href={item.source} target="_blank" rel="noopener noreferrer">
                    <strong>{item.benchmark} ↗</strong>
                    <span>{item.signal}</span>
                  </a>
                </td>
                <td>{item.result}</td>
                <td>{item.use}</td>
                <td><a class="link" href={item.source} target="_blank" rel="noopener noreferrer">{item.sourceLabel} ↗</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section id="method" class="section-shell section-block method-section">
      <div class="section-heading reveal">
        <span class="section-index">06</span>
        <div>
          <span class="mono-label">Method and limitations</span>
          <h2>What this guide can and cannot prove.</h2>
        </div>
      </div>

      <div class="method-grid">
        <article>
          <h3>Decision rule</h3>
          <p>
            Remove strict cost-quality dominance, set a minimum capability floor, then choose
            defaults and escalation points against role-specific evidence. Cost is evaluated per
            accepted artifact, not per prompt.
          </p>
        </article>
        <article>
          <h3>Deployment versus benchmark</h3>
          <p>
            Devin lists GPT-5.6 through Extra High reasoning, while FrontierCode includes Max.
            The policy deploys XHigh and labels Max as benchmark-only. If Max becomes selectable,
            rerun the organization eval before changing the picker.
          </p>
        </article>
        <article>
          <h3>Harness sensitivity</h3>
          <p>
            A model score includes the agent harness, tools, context policy, effort, and stopping
            rules. Provider tables and live leaderboards can report different absolute results.
          </p>
        </article>
        <article>
          <h3>Promotional prices</h3>
          <p>

---
// AI Tank ocean: a fixed, full-viewport "photoreal 8-bit" reef scene seen
// from the sea floor looking up. The scene is painted with real shapes,
// gradients and depth haze into a low-resolution buffer, then every frame is
// posterized with ordered (Bayer) dithering and upscaled with crisp pixels.
// That keeps the light, depth and color of a reef photo while reading as
// pixel art. Everything is procedural: no image assets.
//
// Contract (keep stable):
//   dim?: boolean  -> darker, calmer variant for the admin dashboard
export interface Props {
  dim?: boolean;
}
const { dim = false } = Astro.props;
---

<div class:list={['tank-ocean', { 'tank-ocean--dim': dim }]} data-dim={dim ? '1' : '0'} aria-hidden="true">
  <canvas class="tank-ocean__canvas"></canvas>
</div>

<style>
  .tank-ocean {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    background: #0a3f7a;
  }
  .tank-ocean__canvas {
    position: absolute;
    left: 0;
    top: 0;
    display: block;
    image-rendering: crisp-edges;
    image-rendering: pixelated;
  }
</style>

<script>
  type RGB = [number, number, number];

  interface Fish {
    kind: 'jack' | 'anthias' | 'butterfly' | 'tang' | 'bluetang' | 'wrasse';
    x: number;
    y: number;
    ox: number;
    oy: number;
    len: number;
    phase: number;
  }
  interface School {
    x: number;
    y: number;
    baseY: number;
    vx: number;
    z: number;
    fish: Fish[];
    hover: boolean;
    spread: number;
  }
  interface Big {
    kind: 'shark' | 'manta' | 'turtle';
    x: number;
    y: number;
    baseY: number;
    vx: number;
    size: number;
    z: number;
    phase: number;
  }
  interface Tuft {
    x: number;
    y: number;
    len: number;
    strands: number;
    color: RGB;
    tip: RGB;
    phase: number;
  }
  interface Mote {
    x: number;
    y: number;
    v: number;
    r: number;
    phase: number;
    bubble: boolean;
  }

  const host = document.querySelector<HTMLElement>('.tank-ocean');
  const canvas = host?.querySelector<HTMLCanvasElement>('.tank-ocean__canvas') ?? null;
  const out = canvas?.getContext('2d', { alpha: false }) ?? null;

  if (host && canvas && out) {
    const dim = host.dataset.dim === '1';
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

    // ---------------------------------------------------------------- utils
    const clamp = (v: number, a: number, b: number) => (v < a ? a : v > b ? b : v);
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    const mix = (a: RGB, b: RGB, t: number): RGB => [lerp(a[0], b[0], t), lerp(a[1], b[1], t), lerp(a[2], b[2], t)];
    const shade = (c: RGB, k: number): RGB => (k >= 0 ? mix(c, [255, 255, 255], k) : mix(c, [0, 0, 0], -k));
    const css = (c: RGB, a = 1) => `rgba(${c[0] | 0},${c[1] | 0},${c[2] | 0},${a})`;
    const smooth = (e0: number, e1: number, x: number) => {
      const t = clamp((x - e0) / (e1 - e0), 0, 1);
      return t * t * (3 - 2 * t);
    };
    function mulberry32(seed: number) {
      return () => {
        seed |= 0;
        seed = (seed + 0x6d2b79f5) | 0;
        let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }
    let rnd = mulberry32(7);
    const rr = (a: number, b: number) => a + (b - a) * rnd();
    const pick = <T,>(list: T[]): T => list[Math.floor(rnd() * list.length)];
    const make = (w: number, h: number) => {
      const c = document.createElement('canvas');
      c.width = w;
      c.height = h;
      return c;
    };

    // ---------------------------------------------------------------- water
    // Water column color by normalized depth (0 = surface, 1 = sea floor).
    const WATER: Array<[number, RGB]> = [
      [0.0, [170, 240, 255]],
      [0.07, [70, 205, 245]],
      [0.28, [26, 140, 212]],
      [0.52, [14, 92, 170]],
      [0.78, [9, 58, 124]],
      [1.0, [6, 34, 84]],
    ];
    function waterAt(yn: number): RGB {
      const y = clamp(yn, 0, 1);
      for (let i = 1; i < WATER.length; i += 1) {
        const [y1, c1] = WATER[i];
        if (y <= y1) {
          const [y0, c0] = WATER[i - 1];
          return mix(c0, c1, (y - y0) / (y1 - y0));
        }
      }
      return WATER[WATER.length - 1][1];
    }
    /** Haze a color toward the water around it; z = 1 is close, 0 is far. */
    const fog = (c: RGB, y: number, z: number): RGB => mix(c, waterAt(y / H), clamp((1 - z) * 0.82, 0, 0.88));

    // ---------------------------------------------------------------- state
    let W = 0;
    let H = 0;
    let S = 3;
    let M = 0; // min(W, H)
    let sunX = 0;
    let surfH = 0;
    let bg: HTMLCanvasElement = make(1, 1);
    let reef: HTMLCanvasElement = make(1, 1);
    let reefMask = new Uint8Array(0);
    let vignette = new Float32Array(0);
    let reefTopAt: (x: number) => number = () => 0;
    const buf = make(1, 1);
    const b = buf.getContext('2d', { willReadFrequently: true })!;

    let schools: School[] = [];
    let bigs: Big[] = [];
    let tufts: Tuft[] = [];
    let motes: Mote[] = [];
    let rays: Array<{ x: number; angle: number; w0: number; w1: number; a: number; phase: number }> = [];

    // ---------------------------------------------------------------- setup
    function resize() {
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      S = vw < 700 ? 2 : vw < 2000 ? 3 : 4;
      W = Math.ceil(vw / S);
      H = Math.ceil(vh / S);
      M = Math.min(W, H);
      canvas!.width = W;
      canvas!.height = H;
      canvas!.style.width = `${W * S}px`;
      canvas!.style.height = `${H * S}px`;
      buf.width = W;
      buf.height = H;
      sunX = W * 0.6;
      surfH = Math.round(H * 0.085);
      rnd = mulberry32(1337);
      tufts = [];
      buildBackground();
      buildReef();
      buildVignette();
      spawnLife();
    }

    function buildBackground() {
      bg = make(W, H);
      const g = bg.getContext('2d')!;
      const grad = g.createLinearGradient(0, 0, 0, H);
      for (const [y, c] of WATER) grad.addColorStop(y, css(c));
      g.fillStyle = grad;
      g.fillRect(0, 0, W, H);
      // Sun glow through the surface.
      const r = Math.max(W, H) * 0.75;
      const sun = g.createRadialGradient(sunX, -H * 0.04, 0, sunX, -H * 0.04, r);
      sun.addColorStop(0, 'rgba(255,255,236,0.95)');
      sun.addColorStop(0.12, 'rgba(225,252,255,0.7)');
      sun.addColorStop(0.4, 'rgba(120,225,255,0.22)');
      sun.addColorStop(1, 'rgba(120,225,255,0)');
      g.fillStyle = sun;
      g.fillRect(0, 0, W, H);
      // Distant haze band where the reef meets open water.
      const haze = g.createLinearGradient(0, H * 0.45, 0, H * 0.85);
      haze.addColorStop(0, 'rgba(40,150,215,0)');
      haze.addColorStop(0.6, 'rgba(40,150,215,0.22)');
      haze.addColorStop(1, 'rgba(20,90,160,0)');
      g.fillStyle = haze;
      g.fillRect(0, 0, W, H);

      rays = [];
      const count = dim ? 5 : 9;
      for (let i = 0; i < count; i += 1) {
        rays.push({
          x: sunX + rr(-0.35, 0.35) * W,
          angle: rr(-0.55, 0.55),
          w0: rr(2, 7),
          w1: rr(18, 46) * (M / 200),
          a: rr(0.08, 0.2),
          phase: rr(0, 6.28),
        });
      }
    }

    // Reef silhouettes: three layers back to front, banks rising on the sides
    // with a sandy channel in the middle.
    function buildReef() {
      reef = make(W, H);
      const g = reef.getContext('2d')!;
      const portrait = H > W;
      const bankScale = portrait ? 0.2 : 0.3;
      const layers = [
        { fog: 0.62, lift: 0.1, z: 0.35, seed: 2.1 },
        { fog: 0.32, lift: 0.05, z: 0.65, seed: 4.7 },
        { fog: 0.0, lift: 0.0, z: 1.0, seed: 8.3 },
      ];
      const profile = (x: number, li: number) => {
        const L = layers[li];
        const u = x / W;
        const bankL = 1 - smooth(0.0, 0.42, u);
        const bankR = smooth(0.58, 1.0, u);
        const banks = Math.max(bankL, bankR * 0.85);
        const valley = li === 0 ? 1 : 0.3 + 0.7 * smooth(0, 0.6, banks);
        const base = H * (0.11 + L.lift) * valley;
        const bank = H * (bankScale - L.lift * 0.4) * banks;
        const noise = (Math.sin(x * 0.09 + L.seed) * 0.6 + Math.sin(x * 0.033 + L.seed * 2) * 0.4) * H * 0.022;
        return H - (base + bank + noise);
      };
      reefTopAt = (x: number) => profile(clamp(x, 0, W), 2);
      const fogC = (c: RGB, layer: { fog: number }, y = H * 0.8): RGB => mix(c, waterAt(y / H), layer.fog);

      const coralColors: RGB[] = [
        [255, 120, 168], [255, 138, 92], [255, 186, 64], [255, 226, 110], [178, 110, 255],
        [222, 168, 255], [236, 214, 168], [64, 214, 196], [232, 76, 90], [250, 160, 200],
      ];
      const rock: RGB = [78, 74, 118];

      // Sand channel, lit from above, between the back reef and the near banks.
      const drawSand = () => {
      const sandTop = H * 0.84;
      const sand = g.createLinearGradient(0, sandTop, 0, H);
      sand.addColorStop(0, css(mix([238, 214, 158], waterAt(0.84), 0.3)));
      sand.addColorStop(1, css(mix([214, 184, 128], waterAt(1), 0.22)));
      g.fillStyle = sand;
      g.beginPath();
      g.moveTo(0, H);
      for (let x = 0; x <= W; x += 2) g.lineTo(x, sandTop + Math.sin(x * 0.05) * 2 + Math.sin(x * 0.17) * 1);
      g.lineTo(W, H);
      g.fill();
        // Sand ripples.
        g.strokeStyle = 'rgba(120,96,70,0.35)';
        g.lineWidth = 1;
        for (let ry = sandTop + 3; ry < H; ry += 3 + (ry - sandTop) * 0.08) {
          g.beginPath();
          for (let x = 0; x <= W; x += 3) g.lineTo(x, ry + Math.sin(x * 0.12 + ry) * 1.2);
          g.stroke();
        }
        // A few coral heads dotted on the sand.
        for (let i = 0; i < 9; i += 1) {
          const x = W * rr(0.3, 0.7);
          const y = sandTop + rr(2, (H - sandTop) * 0.7);
          const col = mix(pick(coralColors), waterAt(y / H), 0.35);
          if (rnd() < 0.5) dome(g, x, y, rr(3, 6) * (M / 200), col);
          else fan(g, x, y, rr(6, 11) * (M / 200), col);
        }
      };

      layers.forEach((L, li) => {
        if (li === 1) drawSand();
        const yAt = (x: number) => profile(x, li);
        const lit = fogC(shade(rock, 0.3), L);
        const dark = fogC(shade(rock, -0.4), L);
        // Rock mass with a bumpy top.
        const grad = g.createLinearGradient(0, H * 0.45, 0, H);
        grad.addColorStop(0, css(lit));
        grad.addColorStop(1, css(dark));
        g.fillStyle = grad;
        g.beginPath();
        g.moveTo(0, H);
        for (let x = 0; x <= W; x += 1) g.lineTo(x, yAt(x));
        g.lineTo(W, H);
        g.fill();
        for (let x = 0; x < W; x += rr(2, 5)) {
          const r = rr(2, 6) * (0.6 + L.z * 0.6);
          g.beginPath();
          g.arc(x, yAt(x) + r * 0.4, r, 0, Math.PI * 2);
          g.fill();
        }
        // Texture: speckles of light and shadow.
        const speck = Math.round((W * H) / 90);
        for (let i = 0; i < speck; i += 1) {
          const x = rr(0, W);
          const y = rr(yAt(x) + 2, H);
          g.fillStyle = css(rnd() < 0.5 ? shade(lit, 0.18) : shade(dark, -0.2), 0.6);
          g.fillRect(x | 0, y | 0, 1, 1);
        }

        // Corals along the top contour.
        const scale = (0.55 + L.z * 0.55) * (M / 200);
        let x = rr(0, 4);
        while (x < W) {
          const y = yAt(x) + rr(0, 3);
          const base = pick(coralColors);
          const col = fogC(base, L, y);
          const kind = rnd();
          if (kind < 0.22) dome(g, x, y, rr(4, 9) * scale, col);
          else if (kind < 0.44) staghorn(g, x, y, rr(8, 16) * scale, col);
          else if (kind < 0.6) fan(g, x, y, rr(9, 18) * scale, col);
          else if (kind < 0.72) table(g, x, y, rr(7, 13) * scale, col);
          else if (kind < 0.86) tubes(g, x, y, rr(6, 12) * scale, col);
          else if (li === 2) {
            tufts.push({
              x, y, len: rr(6, 12) * scale, strands: Math.round(rr(5, 9)),
              color: col, tip: shade(col, 0.35), phase: rr(0, 6.28),
            });
          } else dome(g, x, y, rr(3, 6) * scale, col);
          x += rr(3, 8) * scale + (li === 0 ? 2 : 0);
        }

        // Fill the reef body below the crest so it reads as living coral, not rock.
        const body: Array<[number, number]> = [];
        const density = (li === 0 ? 70 : 34) * scale * scale;
        const n = Math.round((W * H * 0.3) / Math.max(8, density));
        for (let i = 0; i < n; i += 1) {
          const bx = rr(0, W);
          const top = yAt(bx) + 4;
          if (top >= H - 1) continue;
          body.push([bx, rr(top, H + 4)]);
        }
        body.sort((p, q) => p[1] - q[1]);
        for (const [bx, by] of body) {
          const depth = clamp((by - yAt(bx)) / (H - yAt(bx) + 1), 0, 1);
          const col = shade(fogC(pick(coralColors), L, by), -0.15 - depth * 0.45);
          const k = rnd();
          const sz = scale * (1 + depth * 0.4);
          if (k < 0.34) dome(g, bx, by, rr(3, 8) * sz, col);
          else if (k < 0.52) staghorn(g, bx, by, rr(6, 12) * sz, col);
          else if (k < 0.68) tubes(g, bx, by, rr(5, 9) * sz, col);
          else if (k < 0.84) fan(g, bx, by, rr(6, 12) * sz, col);
          else table(g, bx, by, rr(5, 10) * sz, col);
        }
      });

      // Deepen the very bottom so the UI floor reads.
      g.globalCompositeOperation = 'source-atop';
      const shadow = g.createLinearGradient(0, H * 0.72, 0, H);
      shadow.addColorStop(0, 'rgba(4,12,36,0)');
      shadow.addColorStop(1, 'rgba(4,12,36,0.32)');
      g.fillStyle = shadow;
      g.fillRect(0, 0, W, H);
      g.globalCompositeOperation = 'source-over';

      const data = g.getImageData(0, 0, W, H).data;
      reefMask = new Uint8Array(W * H);
      for (let i = 0; i < W * H; i += 1) reefMask[i] = data[i * 4 + 3] > 140 ? 1 : 0;
    }

    function dome(g: CanvasRenderingContext2D, x: number, y: number, r: number, c: RGB) {
      const grad = g.createRadialGradient(x - r * 0.35, y - r * 0.5, r * 0.1, x, y, r * 1.1);
      grad.addColorStop(0, css(shade(c, 0.35)));
      grad.addColorStop(1, css(shade(c, -0.35)));
      g.fillStyle = grad;
      g.beginPath();
      g.ellipse(x, y, r, r * 0.8, 0, Math.PI, 0);
      g.lineTo(x + r, y + r * 0.3);
      g.lineTo(x - r, y + r * 0.3);
      g.fill();
      // Brain-coral grooves.
      g.strokeStyle = css(shade(c, -0.3), 0.7);
      g.lineWidth = 1;
      for (let i = 0; i < r * 0.9; i += 1) {
        const a = Math.PI + rnd() * Math.PI;
        const d = rnd() * r * 0.8;
        g.beginPath();
        g.moveTo(x + Math.cos(a) * d, y + Math.sin(a) * d * 0.8);
        g.lineTo(x + Math.cos(a + 0.4) * d, y + Math.sin(a + 0.4) * d * 0.8);
        g.stroke();
      }
    }

    function staghorn(g: CanvasRenderingContext2D, x: number, y: number, len: number, c: RGB) {
      g.lineCap = 'round';
      const branch = (bx: number, by: number, a: number, l: number, w: number, depth: number) => {
        const ex = bx + Math.cos(a) * l;
        const ey = by + Math.sin(a) * l;
        g.strokeStyle = css(shade(c, depth * 0.12 - 0.15));
        g.lineWidth = Math.max(1, w);
        g.beginPath();
        g.moveTo(bx, by);
        g.lineTo(ex, ey);
        g.stroke();
        if (depth >= 3 || l < 2.5) {
          g.fillStyle = css(shade(c, 0.45));
          g.fillRect(ex - 0.5, ey - 0.5, 1.5, 1.5);
          return;
        }
        branch(ex, ey, a - rr(0.3, 0.6), l * rr(0.6, 0.78), w * 0.7, depth + 1);
        branch(ex, ey, a + rr(0.3, 0.6), l * rr(0.6, 0.78), w * 0.7, depth + 1);
      };
      const stems = Math.round(rr(2, 4));
      for (let i = 0; i < stems; i += 1) branch(x + rr(-2, 2), y, -Math.PI / 2 + rr(-0.5, 0.5), len * 0.45, len * 0.14, 0);
    }

    function fan(g: CanvasRenderingContext2D, x: number, y: number, size: number, c: RGB) {
      g.lineWidth = 1;
      for (let i = 0; i <= 12; i += 1) {
        const a = -Math.PI / 2 + (i / 12 - 0.5) * 1.9;
        g.strokeStyle = css(shade(c, (i % 3) * 0.08 - 0.1), 0.85);
        g.beginPath();
        g.moveTo(x, y);
        g.quadraticCurveTo(x + Math.cos(a) * size * 0.5, y + Math.sin(a) * size * 0.6, x + Math.cos(a) * size, y + Math.sin(a) * size * 0.95);
        g.stroke();
      }
      g.strokeStyle = css(shade(c, 0.2), 0.55);
      for (let k = 1; k <= 3; k += 1) {
        g.beginPath();
        g.ellipse(x, y, size * k * 0.3, size * k * 0.3 * 0.95, 0, Math.PI * 1.03, Math.PI * 1.97);
        g.stroke();
      }
    }

    function table(g: CanvasRenderingContext2D, x: number, y: number, size: number, c: RGB) {
      g.fillStyle = css(shade(c, -0.3));
      g.fillRect(x - 1, y - size * 0.5, 2, size * 0.5);
      const grad = g.createLinearGradient(0, y - size * 0.75, 0, y - size * 0.4);
      grad.addColorStop(0, css(shade(c, 0.35)));
      grad.addColorStop(1, css(shade(c, -0.25)));
      g.fillStyle = grad;
      g.beginPath();
      g.ellipse(x, y - size * 0.55, size, size * 0.22, rr(-0.15, 0.15), 0, Math.PI * 2);
      g.fill();
    }

    function tubes(g: CanvasRenderingContext2D, x: number, y: number, size: number, c: RGB) {
      const n = Math.round(rr(2, 4));
      for (let i = 0; i < n; i += 1) {
        const w = Math.max(2, size * rr(0.22, 0.32));
        const h = size * rr(0.7, 1.3);
        const tx = x + (i - n / 2) * w * 1.05;
        const grad = g.createLinearGradient(tx, 0, tx + w, 0);
        grad.addColorStop(0, css(shade(c, 0.25)));
        grad.addColorStop(1, css(shade(c, -0.35)));
        g.fillStyle = grad;
        g.fillRect(tx, y - h, w, h);
        g.fillStyle = css(shade(c, -0.6));
        g.fillRect(tx + 1, y - h, Math.max(1, w - 2), 1);
      }
    }

    function buildVignette() {
      vignette = new Float32Array(W * H);
      for (let y = 0; y < H; y += 1) {
        const yn = y / H;
        const dy = (yn - 0.42) * 1.5;
        for (let x = 0; x < W; x += 1) {
          const dx = (x / W - 0.5) * 1.6;
          vignette[y * W + x] = clamp(1.05 - (dx * dx * 0.8 + dy * dy * (yn > 0.42 ? 0.7 : 0.4)) * 0.38, 0.6, 1.06);
        }
      }
    }

    // ---------------------------------------------------------------- life
    function spawnLife() {
      schools = [];
      bigs = [];
      motes = [];
      const reefY = reefTopAt(W * 0.5);

      // Silvery jacks high in the water, hazed by distance.
      const jackSchools = dim ? 1 : 3;
      for (let s = 0; s < jackSchools; s += 1) {
        const n = Math.round(rr(12, 22));
        const len = rr(0.04, 0.06) * M;
        const school: School = {
          x: rr(0, W), y: 0, baseY: rr(0.16, 0.42) * H, vx: rr(4, 9) * (M / 200) * (rnd() < 0.5 ? -1 : 1),
          z: rr(0.25, 0.5), fish: [], hover: false, spread: rr(0.16, 0.26) * M,
        };
        for (let i = 0; i < n; i += 1) {
          school.fish.push({ kind: 'jack', x: 0, y: 0, ox: rr(-1, 1), oy: rr(-0.5, 0.5), len: len * rr(0.85, 1.15), phase: rr(0, 6.28) });
        }
        schools.push(school);
      }

      // Orange anthias hovering over the reef, plus a few colorful reef fish.
      const anthias: School = {
        x: W * rr(0.4, 0.6), y: 0, baseY: reefY - M * 0.1, vx: 0, z: 0.9, fish: [], hover: true, spread: M * 0.22,
      };
      const nA = dim ? 8 : 20;
      for (let i = 0; i < nA; i += 1) {
        anthias.fish.push({ kind: 'anthias', x: 0, y: 0, ox: rr(-1, 1), oy: rr(-0.6, 0.6), len: M * rr(0.025, 0.035), phase: rr(0, 6.28) });
      }
      schools.push(anthias);
      const reefKinds: Fish['kind'][] = ['butterfly', 'tang', 'bluetang', 'wrasse', 'butterfly', 'tang'];
      const nR = dim ? 2 : 6;
      for (let i = 0; i < nR; i += 1) {
        const x = rr(0, W);
        const loner: School = {
          x, y: 0, baseY: reefTopAt(x) - M * rr(0.03, 0.12), vx: rr(3, 7) * (M / 200) * (rnd() < 0.5 ? -1 : 1),
          z: rr(0.85, 1), fish: [], hover: false, spread: 0,
        };
        loner.fish.push({ kind: reefKinds[i % reefKinds.length], x: 0, y: 0, ox: 0, oy: 0, len: M * rr(0.05, 0.075), phase: rr(0, 6.28) });
        schools.push(loner);
      }

      // Big animals.
      const portrait = H > W;
      bigs.push({
        kind: 'shark', x: W * 0.15, y: 0, baseY: H * (portrait ? 0.44 : 0.4), vx: M * 0.05,
        size: M * (portrait ? 0.62 : 0.55), z: 0.95, phase: 0,
      });
      if (!dim) {
        bigs.push({ kind: 'shark', x: W * 0.8, y: 0, baseY: H * 0.22, vx: -M * 0.035, size: M * 0.26, z: 0.4, phase: 2 });
        bigs.push({ kind: 'shark', x: W * 0.35, y: 0, baseY: H * 0.62, vx: M * 0.03, size: M * 0.2, z: 0.3, phase: 4 });
        bigs.push({ kind: 'manta', x: W * 0.25, y: 0, baseY: H * 0.18, vx: M * 0.025, size: M * 0.34, z: 0.55, phase: 1 });
        bigs.push({ kind: 'turtle', x: W * 0.75, y: 0, baseY: H * (portrait ? 0.6 : 0.5), vx: -M * 0.02, size: M * 0.22, z: 0.8, phase: 3 });
      } else {
        bigs.push({ kind: 'manta', x: W * 0.7, y: 0, baseY: H * 0.2, vx: -M * 0.02, size: M * 0.28, z: 0.5, phase: 1 });
      }

      // Marine snow and bubbles.
      const snow = Math.round((W * H) / (dim ? 900 : 450));
      for (let i = 0; i < snow; i += 1) {
        motes.push({ x: rr(0, W), y: rr(0, H), v: rr(0.6, 2), r: rnd() < 0.85 ? 1 : 2, phase: rr(0, 6.28), bubble: false });
      }
      const bubbles = dim ? 6 : 16;
      for (let i = 0; i < bubbles; i += 1) {
        motes.push({ x: rr(0, W), y: rr(0, H), v: rr(8, 18) * (M / 200), r: rnd() < 0.7 ? 1 : 2, phase: rr(0, 6.28), bubble: true });
      }
    }

    // ---------------------------------------------------------------- creatures
    const FISH_COLORS: Record<Fish['kind'], { top: RGB; belly: RGB; fin: RGB; stripes?: RGB; tall: number }> = {
      jack: { top: [70, 104, 134], belly: [205, 222, 232], fin: [90, 120, 150], tall: 0.36 },
      anthias: { top: [255, 120, 60], belly: [255, 190, 120], fin: [255, 150, 80], tall: 0.4 },
      butterfly: { top: [255, 214, 60], belly: [255, 246, 210], fin: [255, 190, 40], stripes: [30, 30, 40], tall: 0.75 },
      tang: { top: [255, 220, 40], belly: [255, 238, 120], fin: [250, 200, 30], tall: 0.7 },
      bluetang: { top: [40, 90, 220], belly: [90, 150, 255], fin: [255, 214, 40], tall: 0.55 },
      wrasse: { top: [60, 200, 150], belly: [170, 240, 200], fin: [230, 90, 160], stripes: [230, 90, 160], tall: 0.32 },
    };

    function drawFish(f: Fish, x: number, y: number, dir: number, z: number, t: number) {
      const p = FISH_COLORS[f.kind];
      const L = f.len;
      const h = L * p.tall;
      const top = fog(p.top, y, z);
      const belly = fog(p.belly, y, z);
      const fin = fog(p.fin, y, z);
      const wag = Math.sin(t * 9 + f.phase) * h * 0.25;
      b.save();
      b.translate(x, y);
      b.scale(dir, 1);
      // Tail.
      b.fillStyle = css(fin);
      b.beginPath();
      b.moveTo(-L * 0.36, 0);
      b.lineTo(-L * 0.62, -h * 0.55 + wag);
      b.lineTo(-L * 0.55, wag * 0.6);
      b.lineTo(-L * 0.62, h * 0.55 + wag);
      b.closePath();
      b.fill();
      // Dorsal fin for tall fish.
      if (p.tall > 0.5) {
        b.beginPath();
        b.moveTo(L * 0.15, -h * 0.4);
        b.quadraticCurveTo(-L * 0.1, -h * 0.85, -L * 0.36, -h * 0.15);
        b.fill();
      }
      // Countershaded body.
      const grad = b.createLinearGradient(0, -h / 2, 0, h / 2);
      grad.addColorStop(0, css(top));
      grad.addColorStop(1, css(belly));
      b.fillStyle = grad;
      b.beginPath();
      b.ellipse(0, 0, L * 0.42, h / 2, 0, 0, Math.PI * 2);
      b.fill();
      if (p.stripes && L > 6) {
        b.fillStyle = css(fog(p.stripes, y, z), 0.85);
        if (f.kind === 'wrasse') {
          b.fillRect(-L * 0.3, -h * 0.1, L * 0.6, Math.max(1, h * 0.18));
        } else {
          for (let i = 0; i < 3; i += 1) b.fillRect(-L * 0.18 + i * L * 0.16, -h * 0.45, Math.max(1, L * 0.06), h * 0.9);
        }
      }
      if (L >= 7) {
        b.fillStyle = css(fog([12, 16, 24], y, z));
        b.fillRect(L * 0.24, -h * 0.12, 1, 1);
      }
      b.restore();
    }

    function drawShark(s: Big, t: number) {
      const L = s.size;
      const dir = Math.sign(s.vx) || 1;
      const y = s.y;
      const z = s.z;
      const sway = Math.sin(t * 2.2 + s.phase) * 0.16;
      const top = fog([62, 86, 116], y, z);
      const mid = fog([118, 146, 172], y, z);
      const belly = fog([228, 236, 242], y, z);
      const fin = fog([52, 72, 100], y, z);
      const line = fog([28, 40, 58], y, z);
      b.save();
      b.translate(s.x, y);
      b.scale(dir, 1);

      // Caudal fin, pivoting at the tail base.
      b.save();
      b.translate(-L * 0.4, 0);
      b.rotate(sway);
      b.fillStyle = css(fin);
      b.beginPath();
      b.moveTo(L * 0.03, -L * 0.02);
      b.quadraticCurveTo(-L * 0.08, -L * 0.1, -L * 0.2, -L * 0.2);
      b.quadraticCurveTo(-L * 0.14, -L * 0.06, -L * 0.09, 0);
      b.quadraticCurveTo(-L * 0.12, L * 0.05, -L * 0.15, L * 0.12);
      b.quadraticCurveTo(-L * 0.04, L * 0.06, L * 0.03, L * 0.025);
      b.closePath();
      b.fill();
      b.restore();

      // Far-side pectoral fin.
      b.fillStyle = css(shade(fin, -0.15));
      b.beginPath();
      b.moveTo(L * 0.16, L * 0.05);
      b.quadraticCurveTo(L * 0.08, L * 0.14, L * 0.02 + sway * L * 0.05, L * 0.17);
      b.lineTo(L * 0.1, L * 0.06);
      b.fill();

      // First dorsal fin.
      b.fillStyle = css(fin);
      b.beginPath();
      b.moveTo(L * 0.08, -L * 0.095);
      b.quadraticCurveTo(L * 0.0, -L * 0.17, -L * 0.04, -L * 0.235);
      b.quadraticCurveTo(-L * 0.06, -L * 0.15, -L * 0.12, -L * 0.085);
      b.closePath();
      b.fill();
      // Second dorsal and anal fins.
      b.beginPath();
      b.moveTo(-L * 0.27, -L * 0.05);
      b.lineTo(-L * 0.31, -L * 0.095);
      b.lineTo(-L * 0.33, -L * 0.04);
      b.fill();
      b.beginPath();
      b.moveTo(-L * 0.25, L * 0.05);
      b.lineTo(-L * 0.3, L * 0.09);
      b.lineTo(-L * 0.32, L * 0.035);
      b.fill();

      // Body with countershading.
      const grad = b.createLinearGradient(0, -L * 0.11, 0, L * 0.1);
      grad.addColorStop(0, css(top));
      grad.addColorStop(0.45, css(mid));
      grad.addColorStop(0.62, css(belly));
      grad.addColorStop(1, css(shade(belly, -0.15)));
      b.fillStyle = grad;
      b.beginPath();
      b.moveTo(L * 0.5, L * 0.01);
      b.bezierCurveTo(L * 0.45, -L * 0.07, L * 0.25, -L * 0.115, L * 0.05, -L * 0.11);
      b.bezierCurveTo(-L * 0.15, -L * 0.1, -L * 0.32, -L * 0.05, -L * 0.42, -L * 0.018);
      b.lineTo(-L * 0.42, L * 0.022);
      b.bezierCurveTo(-L * 0.3, L * 0.06, -L * 0.1, L * 0.1, L * 0.12, L * 0.095);
      b.bezierCurveTo(L * 0.3, L * 0.09, L * 0.42, L * 0.06, L * 0.47, L * 0.035);
      b.quadraticCurveTo(L * 0.51, L * 0.025, L * 0.5, L * 0.01);
      b.fill();

      // Skin: a darker ridge, a lit flank and fine mottling, clipped to the body.
      b.save();
      b.clip();
      const ridge = b.createLinearGradient(0, -L * 0.12, 0, -L * 0.03);
      ridge.addColorStop(0, css(shade(top, -0.25), 0.9));
      ridge.addColorStop(1, css(top, 0));
      b.fillStyle = ridge;
      b.fillRect(-L * 0.5, -L * 0.13, L, L * 0.1);
      const flank = b.createRadialGradient(L * 0.18, -L * 0.03, 0, L * 0.18, -L * 0.03, L * 0.3);
      flank.addColorStop(0, 'rgba(255,255,255,0.22)');
      flank.addColorStop(1, 'rgba(255,255,255,0)');
      b.fillStyle = flank;
      b.fillRect(-L * 0.5, -L * 0.13, L, L * 0.26);
      const sr = mulberry32(Math.round(L * 10) + (s.phase * 97 | 0));
      for (let i = 0; i < L * 1.2; i += 1) {
        const mx = (sr() - 0.5) * L * 0.85;
        const my = -L * 0.1 + sr() * L * 0.09;
        b.fillStyle = css(sr() < 0.5 ? shade(top, -0.2) : shade(mid, 0.12), 0.45);
        b.fillRect(mx, my, 1, 1);
      }
      b.restore();

      // Mouth line, gills and eye.
      b.strokeStyle = css(line, 0.75);
      b.lineWidth = Math.max(1, L * 0.006);
      b.beginPath();
      b.moveTo(L * 0.43, L * 0.045);
      b.quadraticCurveTo(L * 0.38, L * 0.06, L * 0.33, L * 0.05);
      b.stroke();
      for (let i = 0; i < 4; i += 1) {
        const gx = L * (0.27 - i * 0.022);
        b.beginPath();
        b.moveTo(gx, -L * 0.03);
        b.quadraticCurveTo(gx - L * 0.01, L * 0.01, gx, L * 0.045);
        b.stroke();
      }
      b.fillStyle = css(fog([8, 10, 14], y, z));
      b.beginPath();
      b.arc(L * 0.385, -L * 0.024, Math.max(0.7, L * 0.008), 0, Math.PI * 2);
      b.fill();

      // Near-side pectoral fin, sweeping back.
      const pg = b.createLinearGradient(0, L * 0.05, 0, L * 0.22);
      pg.addColorStop(0, css(mid));
      pg.addColorStop(1, css(fin));
      b.fillStyle = pg;
      b.beginPath();
      b.moveTo(L * 0.2, L * 0.06);
      b.quadraticCurveTo(L * 0.12, L * 0.13, L * 0.03 - sway * L * 0.05, L * 0.19);
      b.quadraticCurveTo(L * 0.08, L * 0.11, L * 0.08, L * 0.075);
      b.closePath();
      b.fill();

      // Sun on the back.
      b.strokeStyle = css(shade(top, 0.35), 0.5);
      b.beginPath();
      b.moveTo(L * 0.4, -L * 0.06);
      b.bezierCurveTo(L * 0.25, -L * 0.1, L * 0.05, -L * 0.105, -L * 0.2, -L * 0.07);
      b.stroke();
      b.restore();
    }

    function drawManta(m: Big, t: number) {
      const L = m.size;
      const y = m.y;
      const dir = Math.sign(m.vx) || 1;
      const flap = Math.sin(t * 1.4 + m.phase);
      const top = fog([40, 58, 84], y, m.z);
      const edge = fog([26, 38, 58], y, m.z);
      const under = fog([150, 176, 200], y, m.z);
      b.save();
      b.translate(m.x, y);
      b.scale(dir, 1);
      // Tail whip.
      b.strokeStyle = css(edge);
      b.lineWidth = 1;
      b.beginPath();
      b.moveTo(-L * 0.2, 0);
      b.quadraticCurveTo(-L * 0.45, Math.sin(t * 2 + m.phase) * L * 0.05, -L * 0.62, L * 0.02);
      b.stroke();
      // Wings: diamond seen at a slight angle, tips flapping.
      const tipUp = -L * (0.42 + flap * 0.1);
      const tipDown = L * (0.3 - flap * 0.08);
      const grad = b.createLinearGradient(0, tipUp, 0, tipDown);
      grad.addColorStop(0, css(top));
      grad.addColorStop(0.5, css(mix(top, under, 0.35)));
      grad.addColorStop(1, css(edge));
      b.fillStyle = grad;
      b.beginPath();
      b.moveTo(L * 0.24, 0);
      b.quadraticCurveTo(L * 0.12, tipUp * 0.35, -L * 0.02, tipUp);
      b.quadraticCurveTo(-L * 0.05, tipUp * 0.4, -L * 0.22, 0);
      b.quadraticCurveTo(-L * 0.05, tipDown * 0.4, -L * 0.04, tipDown);
      b.quadraticCurveTo(L * 0.12, tipDown * 0.35, L * 0.24, 0);
      b.fill();
      // Cephalic lobes.
      b.fillStyle = css(edge);
      b.fillRect(L * 0.22, -L * 0.035, L * 0.06, Math.max(1, L * 0.02));
      b.fillRect(L * 0.22, L * 0.015, L * 0.06, Math.max(1, L * 0.02));
      // Spots.
      b.fillStyle = css(under, 0.7);
      for (let i = 0; i < 5; i += 1) b.fillRect(L * (0.08 - i * 0.05), -L * 0.02 + (i % 2) * L * 0.03, 1, 1);
      b.restore();
    }

    function drawTurtle(tu: Big, t: number) {
      const L = tu.size;
      const y = tu.y;
      const dir = Math.sign(tu.vx) || 1;
      const paddle = Math.sin(t * 1.6 + tu.phase);
      const skin = fog([120, 140, 96], y, tu.z);
      const skinDark = fog([70, 86, 58], y, tu.z);
      const shell = fog([150, 110, 60], y, tu.z);
      const shellDark = fog([86, 60, 32], y, tu.z);
      b.save();
      b.translate(tu.x, y);
      b.scale(dir, 1);
      // Flippers, far side.
      b.fillStyle = css(skinDark);
      b.save();
      b.translate(L * 0.12, L * 0.05);
      b.rotate(0.4 + paddle * 0.5);
      b.beginPath();
      b.ellipse(-L * 0.18, 0, L * 0.26, L * 0.06, 0, 0, Math.PI * 2);
      b.fill();
      b.restore();
      b.beginPath();
      b.ellipse(-L * 0.3, L * 0.08, L * 0.1, L * 0.04, 0.5 - paddle * 0.3, 0, Math.PI * 2);
      b.fill();
      // Head.
      b.fillStyle = css(skin);
      b.beginPath();
      b.ellipse(L * 0.38, -L * 0.02, L * 0.1, L * 0.07, -0.1, 0, Math.PI * 2);
      b.fill();
      b.fillStyle = css(fog([10, 12, 10], y, tu.z));
      b.fillRect(L * 0.42, -L * 0.04, 1, 1);
      // Shell.
      const grad = b.createRadialGradient(-L * 0.05, -L * 0.12, L * 0.03, 0, 0, L * 0.34);
      grad.addColorStop(0, css(shade(shell, 0.3)));
      grad.addColorStop(1, css(shellDark));
      b.fillStyle = grad;
      b.beginPath();
      b.ellipse(0, 0, L * 0.33, L * 0.19, -0.05, 0, Math.PI * 2);
      b.fill();
      // Scutes: a row of lit plates along the spine, flanked by smaller ones.
      for (let i = -1; i <= 1; i += 1) {
        b.fillStyle = css(shade(shell, 0.18 - Math.abs(i) * 0.08));
        b.beginPath();
        b.ellipse(i * L * 0.13, -L * 0.05, L * 0.06, L * 0.05, 0, 0, Math.PI * 2);
        b.fill();
        b.fillStyle = css(shade(shell, -0.05));
        b.beginPath();
        b.ellipse(i * L * 0.13, L * 0.06, L * 0.055, L * 0.035, 0, 0, Math.PI * 2);
        b.fill();
      }
      b.strokeStyle = css(shade(shell, 0.45), 0.8);
      b.lineWidth = 1;
      b.beginPath();
      b.ellipse(0, 0, L * 0.33, L * 0.19, -0.05, Math.PI * 1.1, Math.PI * 1.9);
      b.stroke();
      // Front flipper, near side.
      b.fillStyle = css(skin);
      b.save();
      b.translate(L * 0.14, L * 0.08);
      b.rotate(0.6 - paddle * 0.6);
      b.beginPath();
      b.ellipse(-L * 0.19, 0, L * 0.3, L * 0.075, 0, 0, Math.PI * 2);
      b.fill();
      b.restore();
      b.restore();
    }

    function drawBig(o: Big, t: number) {
      if (o.kind === 'shark') drawShark(o, t);
      else if (o.kind === 'manta') drawManta(o, t);
      else drawTurtle(o, t);
    }

    function drawSchool(s: School, t: number) {
      const dir = s.hover ? 1 : Math.sign(s.vx) || 1;
      for (const f of s.fish) {
        let fx: number;
        let fy: number;
        let fdir = dir;
        if (s.hover) {
          // Anthias pick at plankton: small wandering orbits, each its own way.
          fx = s.x + f.ox * s.spread + Math.sin(t * 0.5 + f.phase) * M * 0.03;
          fy = s.baseY + f.oy * s.spread * 0.35 + Math.sin(t * 0.8 + f.phase * 2) * M * 0.015;
          fdir = Math.cos(t * 0.5 + f.phase) >= 0 ? 1 : -1;
        } else {
          fx = s.x + f.ox * s.spread + Math.sin(t * 0.7 + f.phase) * 2;
          fy = s.y + f.oy * s.spread * 0.6 + Math.sin(t * 1.1 + f.phase) * 1.5;
        }
        drawFish(f, fx, fy, fdir, s.z, t);
      }
    }

    // ---------------------------------------------------------------- frame
    const BAYER = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5].map((v) => v / 16 - 0.47);
    const LEVELS: RGB = [7, 9, 9];

    function update(dt: number, t: number) {
      const margin = M * 0.7;
      for (const s of schools) {
        if (s.hover) continue;
        s.x += s.vx * dt;
        s.y = s.baseY + Math.sin(t * 0.3 + s.z * 10) * M * 0.03;
        if (s.vx > 0 && s.x > W + margin) respawnSchool(s, -margin);
        if (s.vx < 0 && s.x < -margin) respawnSchool(s, W + margin);
      }
      for (const o of bigs) {
        o.x += o.vx * dt;
        o.y = o.baseY + Math.sin(t * 0.35 + o.phase) * M * 0.03;
        const pad = o.size * 0.8;
        if (o.vx > 0 && o.x > W + pad) {
          o.vx = -Math.abs(o.vx);
          o.baseY = clamp(o.baseY + rr(-0.08, 0.08) * H, H * 0.12, H * 0.66);
        } else if (o.vx < 0 && o.x < -pad) {
          o.vx = Math.abs(o.vx);
          o.baseY = clamp(o.baseY + rr(-0.08, 0.08) * H, H * 0.12, H * 0.66);
        }
      }
      for (const m of motes) {
        if (m.bubble) {
          m.y -= m.v * dt;
          m.x += Math.sin(t * 3 + m.phase) * 0.15;
          if (m.y < surfH) {
            m.x = rr(0, W);
            m.y = reefTopAt(m.x) + rr(0, 6);
          }
        } else {
          m.y += m.v * dt * 0.6;
          m.x += Math.sin(t * 0.4 + m.phase) * 0.05;
          if (m.y > H) {
            m.y = rr(-4, 0);
            m.x = rr(0, W);
          }
        }
      }
    }

    function respawnSchool(s: School, x: number) {
      s.x = x;
      s.baseY = rr(0.16, 0.45) * H;
    }

    function render(t: number) {
      b.globalCompositeOperation = 'source-over';
      b.globalAlpha = 1;
      b.drawImage(bg, 0, 0);

      const byDepth = [...bigs].sort((a, c) => a.z - c.z);
      byDepth.filter((o) => o.z < 0.6).forEach((o) => drawBig(o, t));
      schools.filter((s) => !s.hover && s.z < 0.6).forEach((s) => drawSchool(s, t));

      // God rays, slowly swaying and breathing.
      b.globalCompositeOperation = 'lighter';
      for (const r of rays) {
        const a = r.angle + Math.sin(t * 0.12 + r.phase) * 0.05;
        const alpha = r.a * (0.65 + 0.35 * Math.sin(t * 0.45 + r.phase * 1.7)) * (dim ? 0.6 : 1);
        const len = H * 1.05;
        const ex = r.x + Math.sin(a) * len;
        const grad = b.createLinearGradient(r.x, 0, ex, len);
        grad.addColorStop(0, `rgba(220,250,255,${alpha})`);
        grad.addColorStop(0.55, `rgba(160,230,255,${alpha * 0.45})`);
        grad.addColorStop(1, 'rgba(120,210,255,0)');
        b.fillStyle = grad;
        b.beginPath();
        b.moveTo(r.x - r.w0, 0);
        b.lineTo(r.x + r.w0, 0);
        b.lineTo(ex + r.w1, len);
        b.lineTo(ex - r.w1, len);
        b.closePath();
        b.fill();
      }
      b.globalCompositeOperation = 'source-over';

      byDepth.filter((o) => o.z >= 0.6 && o.z < 0.9).forEach((o) => drawBig(o, t));
      b.drawImage(reef, 0, 0);

      // Soft corals and anemones swaying in the surge.
      b.lineWidth = 1;
      for (const tf of tufts) {
        for (let i = 0; i < tf.strands; i += 1) {
          const spread = (i / (tf.strands - 1) - 0.5) * tf.len * 0.9;
          const sway = Math.sin(t * 1.3 + tf.phase + i * 0.4) * tf.len * 0.22;
          b.strokeStyle = css(i % 2 ? tf.color : shade(tf.color, -0.15));
          b.beginPath();
          b.moveTo(tf.x, tf.y);
          b.quadraticCurveTo(tf.x + spread * 0.4, tf.y - tf.len * 0.6, tf.x + spread + sway, tf.y - tf.len);
          b.stroke();
          b.fillStyle = css(tf.tip);
          b.fillRect(tf.x + spread + sway - 0.5, tf.y - tf.len - 0.5, 1.5, 1.5);
        }
      }

      schools.filter((s) => s.hover || s.z >= 0.6).forEach((s) => drawSchool(s, t));
      byDepth.filter((o) => o.z >= 0.9).forEach((o) => drawBig(o, t));

      for (const m of motes) {
        if (m.bubble) {
          b.strokeStyle = 'rgba(225,250,255,0.75)';
          b.beginPath();
          b.arc(m.x, m.y, m.r, 0, Math.PI * 2);
          b.stroke();
        } else {
          b.fillStyle = `rgba(220,245,255,${0.25 + 0.2 * Math.sin(t + m.phase)})`;
          b.fillRect(m.x, m.y, m.r, m.r);
        }
      }

      out!.putImageData(posterize(t), 0, 0);
    }

    // Surface ripples, caustics on the reef, vignette, then ordered dithering
    // to a small color cube: the step that makes it pixel art.
    function posterize(t: number): ImageData {
      const img = b.getImageData(0, 0, W, H);
      const d = img.data;
      const lr = LEVELS[0] - 1;
      const lg = LEVELS[1] - 1;
      const lb = LEVELS[2] - 1;
      const dimK = dim ? 0.5 : 1;
      for (let y = 0; y < H; y += 1) {
        const surf = y < surfH ? 1 - y / surfH : 0;
        const yn = y / H;
        const row = (y & 3) * 4;
        for (let x = 0; x < W; x += 1) {
          const i = y * W + x;
          const p = i * 4;
          let r = d[p];
          let g = d[p + 1];
          let bl = d[p + 2];
          if (surf > 0) {
            const n = Math.sin(x * 0.19 + t * 1.2 + Math.sin(y * 0.8 - t * 0.9) * 2.2) * Math.sin(x * 0.061 - t * 0.5 + y * 0.35);
            const k = n > 0.3 ? 85 * surf : n < -0.45 ? -40 * surf : 12 * surf;
            r += k;
            g += k;
            bl += k * 0.7;
          }
          if (reefMask[i]) {
            const c = Math.abs(Math.sin(x * 0.28 + Math.sin(y * 0.21 + t * 0.9) * 2.3 + t * 0.6) * Math.sin(y * 0.33 - t * 0.7 + Math.sin(x * 0.13 - t * 0.4) * 2.1));
            if (c > 0.82) {
              const k = (c - 0.82) * 260 * (1.15 - yn);
              r += k;
              g += k;
              bl += k * 0.9;
            }
          }
          const v = vignette[i] * dimK;
          r *= v;
          g *= v;
          bl *= v;
          if (dim) {
            r += 2;
            g += 6;
            bl += 18;
          }
          const th = BAYER[row + (x & 3)];
          d[p] = clamp(Math.round((r / 255) * lr + th), 0, lr) * (255 / lr);
          d[p + 1] = clamp(Math.round((g / 255) * lg + th), 0, lg) * (255 / lg);
          d[p + 2] = clamp(Math.round((bl / 255) * lb + th), 0, lb) * (255 / lb);
        }
      }
      return img;
    }

    // ---------------------------------------------------------------- loop
    const FRAME = 1 / (dim ? 15 : 24);
    let raf = 0;
    let last = 0;
    let acc = 0;
    let clock = 3;

    function tick(now: number) {
      raf = requestAnimationFrame(tick);
      const dt = last ? Math.min(0.1, (now - last) / 1000) : FRAME;
      last = now;
      acc += dt;
      if (acc < FRAME) return;
      const step = acc;
      acc = 0;
      clock += step;
      update(step, clock);
      render(clock);
    }
    function start() {
      cancelAnimationFrame(raf);
      last = 0;
      if (motionQuery.matches || document.hidden) {
        render(clock);
        return;
      }
      raf = requestAnimationFrame(tick);
    }
    function stop() {
      cancelAnimationFrame(raf);
      raf = 0;
    }

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        resize();
        start();
      }, 150);
    });
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    motionQuery.addEventListener?.('change', start);

    resize();
    render(clock);
    start();
  }
</script>
